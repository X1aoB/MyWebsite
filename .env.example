# Set this to your final Cloudflare Pages custom domain before production deployment.
PUBLIC_SITE_URL=https://your-domain.example

# Obtain these two IDs from https://giscus.app after making X1ao/MyWebsite public,
# enabling GitHub Discussions, and installing the Giscus app.
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY_ID=
