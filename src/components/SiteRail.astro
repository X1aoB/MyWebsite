---
import LocalizedText from "./LocalizedText.astro";
import { getUpdates } from "../lib/updates";
import { projectSnow } from "../config/project-snow";

const latestUpdates = (await getUpdates()).slice(0, 3);
---

<aside class="site-rail" aria-label="站点索引">
  <section class="rail-panel rail-now">
    <p class="rail-label">NOW BUILDING</p>
    <a href="/projects/project-snow/">
      <span class="rail-signal"><i></i> <LocalizedText {...projectSnow.status} /></span>
      <h2><LocalizedText {...projectSnow.productName} /></h2>
      <p><LocalizedText zh="文字通讯与面对面体验，全新界面与 22 位角色的立绘、表情现已加入。" en="Messages and face-to-face stories, now with a new interface and artwork and expressions for 22 characters." /></p>
      <span class="rail-arrow" aria-hidden="true">→</span>
    </a>
  </section>

  <section class="rail-panel">
    <p class="rail-label">站点索引</p>
    <nav class="rail-links" aria-label="快速入口">
      <a href="/journal/"><span>01</span> 开发日志</a>
      <a href="/tools/"><span>02</span> 工具索引</a>
      <a href="/gallery/"><span>03</span> 摄影集</a>
      <a href="/about/"><span>04</span> 关于与作品集</a>
    </nav>
  </section>

  <section class="rail-note rail-updates">
    <div class="rail-note-heading">
      <span aria-hidden="true">✦</span>
      <p class="rail-label">最新更新</p>
      <a href="/updates/">查看全部 ↗</a>
    </div>
    <ol class="rail-update-list">
      {latestUpdates.map((update) => (
        <li>
          <a href={update.url}>
            <time datetime={update.date.toISOString()}>{update.date.toLocaleDateString("zh-CN")}</time>
            <span class="rail-update-source"><LocalizedText {...update.sourceLabel} /></span>
            <strong><LocalizedText {...update.title} /></strong>
          </a>
        </li>
      ))}
    </ol>
  </section>
</aside>
