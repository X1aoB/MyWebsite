---
import { giscus, site } from "../config/site";

const enabled = Boolean(giscus.repoId && giscus.categoryId);
---

<section class="comments-panel" aria-labelledby="comments-title">
  <div class="section-kicker">讨论</div>
  <h2 id="comments-title">留下你的想法</h2>
  {
    enabled ? (
      <div
        data-giscus-root
        data-repo={giscus.repo}
        data-repo-id={giscus.repoId}
        data-category={giscus.category}
        data-category-id={giscus.categoryId}
      ></div>
    ) : (
      <div class="giscus-fallback">
        <p>评论区将在站点部署配置完成后启用。</p>
        <a href={`${site.repositories.website}/discussions`} target="_blank" rel="noreferrer">
          前往 GitHub Discussions 参与讨论 ↗
        </a>
      </div>
    )
  }
</section>

{
  enabled && (
    <script is:inline>
      const host = document.querySelector("[data-giscus-root]");

      if (host) {
        const script = document.createElement("script");
        script.src = "https://giscus.app/client.js";
        script.async = true;
        script.crossOrigin = "anonymous";
        script.setAttribute("data-repo", host.dataset.repo || "");
        script.setAttribute("data-repo-id", host.dataset.repoId || "");
        script.setAttribute("data-category", host.dataset.category || "General");
        script.setAttribute("data-category-id", host.dataset.categoryId || "");
        script.setAttribute("data-mapping", "pathname");
        script.setAttribute("data-strict", "1");
        script.setAttribute("data-reactions-enabled", "1");
        script.setAttribute("data-emit-metadata", "0");
        script.setAttribute("data-input-position", "top");
        script.setAttribute("data-theme", "dark_dimmed");
        script.setAttribute("data-lang", "zh-CN");
        host.append(script);
      }
    </script>
  )
}
