---
import Icon from "./Icon.astro";
interface Props {
  label?: string;
  iceImageSrc?: string;
  iceAlt?: string;
  iceCaption?: string;
  holoImageSrc?: string;
  holoAlt?: string;
  holoCaption?: string;
}

const {
  label = "角色插画预留",
  iceImageSrc = "",
  iceAlt = "",
  iceCaption = "里芙·贝斯特拉",
  holoImageSrc = "",
  holoAlt = "",
  holoCaption = "赫萝"
} = Astro.props;

const hasArtwork = Boolean(iceImageSrc || holoImageSrc);
const responsiveSrcSet = (src: string, sourceWidth: number) =>
  src.endsWith(".webp")
    ? `${src.replace(/\.webp$/, "-320.webp")} 320w, ${src.replace(/\.webp$/, "-640.webp")} 640w, ${src} ${sourceWidth}w`
    : undefined;
const iceImageSrcSet = iceImageSrc ? responsiveSrcSet(iceImageSrc, 1200) : undefined;
const holoImageSrcSet = holoImageSrc ? responsiveSrcSet(holoImageSrc, 900) : undefined;
---

<figure class:list={["character-art-slot", { "has-holo-artwork": Boolean(holoImageSrc) }]} aria-label={iceCaption}>
  {
    hasArtwork ? (
      <div class="character-art-media">
        {holoImageSrc && (
          <svg class="character-art-wheat" viewBox="0 0 100 120" fill="none" aria-hidden="true" focusable="false">
            <path d="M49 111C48 79 52 46 66 12" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" />
            <path fill="currentColor" d="M62 29c-14 1-17 11-10 18 12-3 15-12 10-18ZM70 17c-13 3-15 13-7 19 11-5 13-14 7-19ZM52 44c-13 3-15 13-7 19 11-5 13-14 7-19ZM62 53c-14 1-17 11-10 18 12-3 15-12 10-18ZM44 61c-12 5-12 15-3 20 10-7 10-16 3-20ZM55 73c-13 3-15 13-7 19 11-5 13-14 7-19Z" />
          </svg>
        )}
        {iceImageSrc && (
          <img
            class="character-art-image character-art-image-ice"
            src={iceImageSrc}
            alt={iceAlt}
            width="1200"
            height="1200"
            srcset={iceImageSrcSet}
            sizes="(max-width: 760px) 180px, (max-width: 1199px) 200px, 300px"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            data-theme-image="ice"
          />
        )}
        {holoImageSrc && (
          <img
            class="character-art-image character-art-image-holo"
            data-src={holoImageSrc}
            data-srcset={holoImageSrcSet}
            sizes="(max-width: 760px) 180px, (max-width: 1199px) 200px, 300px"
            alt={holoAlt}
            width="900"
            height="900"
            loading="lazy"
            decoding="async"
            data-theme-image="holo"
            aria-hidden="true"
          />
        )}
      </div>
    ) : (
      <div class="character-art-placeholder" role="img" aria-label={label}>
        <span class="crystal-mark" aria-hidden="true"><Icon name="sparkles" /></span>
        <span class="character-art-label">{label}</span>
        <small>4 : 5</small>
      </div>
    )
  }
  {
    hasArtwork ? (
      <figcaption>
        <span class="character-art-caption character-art-caption-ice">{iceCaption}</span>
        <span class="character-art-caption character-art-caption-holo" aria-hidden="true">{holoCaption}</span>
      </figcaption>
    ) : (
      <figcaption>未来放置主题插画</figcaption>
    )
  }
</figure>
