---
import { site } from "../config/site";
---

<section id="json-workbench" class="tool-shell" aria-labelledby="json-tool-title" data-json-tool>
  <div class="tool-shell-header">
    <div>
      <div class="section-kicker">Browser utility / 01</div>
      <h2 id="json-tool-title">JSON 格式化与校验</h2>
      <p>粘贴 JSON 后在本地完成格式化、压缩和语法检查。内容不会离开当前浏览器。</p>
    </div>
    <a class="tool-source-link" href={`${site.repositories.website}/tree/main/src/components/JsonTool.astro`} target="_blank" rel="noreferrer">查看源码 ↗</a>
  </div>

  <div class="tool-workbench">
    <div>
      <label class="input-label" for="json-input"><span>输入</span><span>仅本地处理</span></label>
      <textarea id="json-input" class="tool-textarea" data-json-input spellcheck="false" placeholder='例如：{ "project": "Project Snow", "phase": 1 }'></textarea>
      <div class="tool-actions" aria-label="JSON 操作">
        <button type="button" data-json-action="format">格式化</button>
        <button type="button" data-json-action="minify">压缩</button>
        <button type="button" data-json-action="validate">校验</button>
        <button type="button" data-json-action="clear">清空</button>
      </div>
    </div>
    <div>
      <label class="input-label" for="json-output"><span>输出</span><span>2 空格缩进</span></label>
      <textarea id="json-output" class="tool-textarea" data-json-output readonly spellcheck="false" placeholder="处理后的内容会显示在这里"></textarea>
      <div class="tool-actions" aria-label="输出操作">
        <button type="button" data-json-action="copy">复制输出</button>
      </div>
    </div>
  </div>
  <p class="tool-status" data-json-status aria-live="polite">等待输入 JSON。</p>
</section>

<script>
  import { formatJsonInput, minifyJsonInput, parseJsonInput } from "../lib/data-tools";

  const initializeJsonTool = () => {
    const root = document.querySelector<HTMLElement>("[data-json-tool]");

    if (root) {
    const input = root.querySelector<HTMLTextAreaElement>("[data-json-input]");
    const output = root.querySelector<HTMLTextAreaElement>("[data-json-output]");
    const status = root.querySelector<HTMLElement>("[data-json-status]");

    const setStatus = (message: string, state: "idle" | "success" | "error" = "idle") => {
      if (!status) return;
      status.textContent = message;
      status.dataset.state = state;
    };

    const parseInput = () => parseJsonInput(input?.value ?? "");

    const copyOutput = async () => {
      const value = output?.value ?? "";
      if (!value) {
        setStatus("没有可复制的输出内容。", "error");
        return;
      }

      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(value);
        } else if (output) {
          output.focus();
          output.select();
          setStatus("浏览器不允许自动复制，已选中输出内容，请手动复制。", "idle");
          return;
        }
        setStatus("已复制到剪贴板。", "success");
      } catch {
        setStatus("无法自动复制，请手动选择输出内容。", "error");
      }
    };

    root.querySelectorAll<HTMLButtonElement>("[data-json-action]").forEach((button) => {
      button.addEventListener("click", async () => {
        const action = button.dataset.jsonAction;

        if (action === "clear") {
          if (input) input.value = "";
          if (output) output.value = "";
          setStatus("已清空输入和输出。", "idle");
          input?.focus();
          return;
        }

        if (action === "copy") {
          await copyOutput();
          return;
        }

        try {
          parseInput();
          if (action === "format") {
            if (output) output.value = formatJsonInput(input?.value ?? "");
            setStatus("JSON 有效，已按 2 空格缩进格式化。", "success");
          }
          if (action === "minify") {
            if (output) output.value = minifyJsonInput(input?.value ?? "");
            setStatus("JSON 有效，已压缩为单行。", "success");
          }
          if (action === "validate") {
            setStatus("JSON 语法有效。", "success");
          }
        } catch (error) {
          const message = error instanceof Error ? error.message : "JSON 解析失败。";
          setStatus(`解析失败：${message}`, "error");
        }
      });
    });
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeJsonTool, { once: true });
  } else {
    initializeJsonTool();
  }
</script>
