---
import { site } from "../config/site";
---

<section id="csv-workbench" class="tool-shell" aria-labelledby="csv-tool-title" data-csv-tool>
  <div class="tool-shell-header">
    <div>
      <div class="section-kicker">Browser utility / 02</div>
      <h2 id="csv-tool-title">CSV 本地预览与字段统计</h2>
      <p>选择 CSV 或 TSV 文件后，在浏览器内识别分隔符、预览前 50 行，并推断每一列的基础类型。文件不会上传。</p>
    </div>
    <a class="tool-source-link" href={`${site.repositories.website}/tree/main/src/components/CsvTool.astro`} target="_blank" rel="noreferrer">查看源码 ↗</a>
  </div>

  <div class="file-dropzone">
    <div>
      <strong>选择一个 CSV / TSV 文件</strong>
      <span>支持带引号字段和 UTF-8 文本；仅在本地浏览器内解析。</span>
      <p style="margin: 14px 0 0"><label class="file-control">选择文件<input data-csv-input type="file" accept=".csv,.tsv,text/csv,text/tab-separated-values" /></label></p>
    </div>
  </div>
  <div class="tool-actions" style="margin-top: 12px"><button type="button" data-csv-clear>清空结果</button></div>
  <p class="tool-status" data-csv-status aria-live="polite">等待选择文件。</p>

  <div data-csv-results hidden>
    <div class="csv-summary" data-csv-summary></div>
    <div class="field-type-list" data-csv-fields aria-label="字段类型统计"></div>
    <div class="csv-table-wrap" tabindex="0" aria-label="CSV 数据预览">
      <div data-csv-table></div>
    </div>
  </div>
</section>

<script>
  import Papa from "papaparse";
  import { inferColumnType, isMeaningfulRow, type CsvRow } from "../lib/data-tools";

  const initializeCsvTool = () => {
    const root = document.querySelector<HTMLElement>("[data-csv-tool]");

    if (root) {
    const fileInput = root.querySelector<HTMLInputElement>("[data-csv-input]");
    const status = root.querySelector<HTMLElement>("[data-csv-status]");
    const results = root.querySelector<HTMLElement>("[data-csv-results]");
    const summary = root.querySelector<HTMLElement>("[data-csv-summary]");
    const fieldsContainer = root.querySelector<HTMLElement>("[data-csv-fields]");
    const tableContainer = root.querySelector<HTMLElement>("[data-csv-table]");
    const clearButton = root.querySelector<HTMLButtonElement>("[data-csv-clear]");

    const setStatus = (message: string, state: "idle" | "success" | "error" = "idle") => {
      if (!status) return;
      status.textContent = message;
      status.dataset.state = state;
    };

    const clearResults = () => {
      if (results) results.hidden = true;
      if (summary) summary.replaceChildren();
      if (fieldsContainer) fieldsContainer.replaceChildren();
      if (tableContainer) tableContainer.replaceChildren();
    };

    const addMetric = (label: string, value: string | number) => {
      if (!summary) return;
      const metric = document.createElement("div");
      metric.className = "csv-metric";
      const labelNode = document.createElement("span");
      const valueNode = document.createElement("strong");
      labelNode.textContent = label;
      valueNode.textContent = String(value);
      metric.append(labelNode, valueNode);
      summary.append(metric);
    };

    const renderFields = (fields: string[], rows: CsvRow[]) => {
      if (!fieldsContainer) return;
      fieldsContainer.replaceChildren();
      fields.forEach((field) => {
        const item = document.createElement("span");
        item.className = "field-type";
        const name = document.createElement("b");
        name.textContent = field;
        item.append(name, document.createTextNode(` · ${inferColumnType(rows.slice(0, 100).map((row) => row[field] ?? ""))}`));
        fieldsContainer.append(item);
      });
    };

    const renderTable = (fields: string[], rows: CsvRow[]) => {
      if (!tableContainer) return;
      tableContainer.replaceChildren();
      const table = document.createElement("table");
      table.className = "csv-table";
      const thead = document.createElement("thead");
      const headerRow = document.createElement("tr");
      fields.forEach((field) => {
        const th = document.createElement("th");
        th.scope = "col";
        th.textContent = field;
        headerRow.append(th);
      });
      thead.append(headerRow);
      const tbody = document.createElement("tbody");
      rows.slice(0, 50).forEach((row) => {
        const tr = document.createElement("tr");
        fields.forEach((field) => {
          const td = document.createElement("td");
          const value = String(row[field] ?? "");
          td.textContent = value;
          td.title = value;
          tr.append(td);
        });
        tbody.append(tr);
      });
      table.append(thead, tbody);
      tableContainer.append(table);
    };

    const parseFile = (file: File) => {
      clearResults();
      setStatus(`正在本地解析 ${file.name}…`);

      Papa.parse<CsvRow>(file, {
        header: true,
        skipEmptyLines: "greedy",
        dynamicTyping: false,
        complete: (parsed) => {
          const fields = parsed.meta.fields ?? [];
          const rows = parsed.data.filter(isMeaningfulRow);
          const errors = parsed.errors.filter((error) => error.code !== "UndetectableDelimiter");

          if (!fields.length) {
            setStatus("未识别到表头。请确认文件首行包含字段名。", "error");
            return;
          }

          if (summary) summary.replaceChildren();
          addMetric("数据行", rows.length);
          addMetric("字段数", fields.length);
          addMetric("分隔符", parsed.meta.delimiter === "\t" ? "TAB" : parsed.meta.delimiter || "自动");
          renderFields(fields, rows);
          renderTable(fields, rows);
          if (results) results.hidden = false;

          const warning = errors.length ? ` 发现 ${errors.length} 个解析警告。` : "";
          setStatus(`已在本地读取 ${rows.length} 行，预览前 ${Math.min(rows.length, 50)} 行。${warning}`, errors.length ? "idle" : "success");
        },
        error: (error) => setStatus(`无法读取文件：${error.message}`, "error")
      });
    };

    fileInput?.addEventListener("change", () => {
      const file = fileInput.files?.[0];
      if (file) parseFile(file);
    });

    clearButton?.addEventListener("click", () => {
      if (fileInput) fileInput.value = "";
      clearResults();
      setStatus("已清空 CSV 结果。", "idle");
    });
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeCsvTool, { once: true });
  } else {
    initializeCsvTool();
  }
</script>
