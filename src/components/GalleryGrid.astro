---
type PhotoAspect = "landscape" | "portrait" | "square";

interface GalleryPhoto {
  image: string;
  alt: string;
  caption: string;
  note?: string;
  aspect: PhotoAspect;
}

interface GallerySet {
  id: string;
  data: {
    title: string;
    date: Date;
    location: string;
    equipment: string;
    description: string;
    cover: {
      image: string;
      alt: string;
      aspect: PhotoAspect;
    };
    photos: GalleryPhoto[];
    tags: string[];
  };
}

interface Props {
  photoSets: GallerySet[];
}

const { photoSets } = Astro.props;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "long", day: "numeric" }).format(date);
---

<ol class="gallery-set-grid" aria-label="摄影套图列表">
  {
    photoSets.map((photoSet, index) => {
      const dialogId = `photo-set-dialog-${photoSet.id.replace(/[^a-z0-9_-]/gi, "-")}`;
      const hashId = `photo-set-${photoSet.id.replace(/[^a-z0-9_-]/gi, "-")}`;
      const dialogTitleId = `${dialogId}-title`;
      const dialogDescriptionId = `${dialogId}-description`;
      const equipment = photoSet.data.equipment || "待补充";

      return (
        <li class="gallery-set-item" data-reveal style={`--reveal-delay: ${index * 75}ms;`}>
          <button
            id={hashId}
            class={`gallery-set-card ${photoSet.data.cover.aspect}`}
            type="button"
            aria-haspopup="dialog"
            aria-controls={dialogId}
            aria-label={`打开套图：${photoSet.data.title}`}
            data-photo-set-open
            data-dialog-id={dialogId}
            data-photo-set-hash={hashId}
          >
            <span class="gallery-set-cover">
              <img
                src={photoSet.data.cover.image}
                alt={photoSet.data.cover.alt}
                loading={index > 1 ? "lazy" : "eager"}
                decoding="async"
              />
              <span class="gallery-set-cover-wash" aria-hidden="true"></span>
              <span class="gallery-set-open" aria-hidden="true">
                <span>↗</span>
                <small>打开套图</small>
              </span>
            </span>
            <span class="gallery-set-copy">
              <span class="gallery-set-meta">
                <time datetime={photoSet.data.date.toISOString()}>{formatDate(photoSet.data.date)}</time>
                <span aria-hidden="true">·</span>
                <span>{photoSet.data.location}</span>
              </span>
              <strong>{photoSet.data.title}</strong>
              <span class="gallery-set-description">{photoSet.data.description}</span>
              <span class="gallery-set-footer">
                <span class="gallery-set-equipment"><span>设备</span><strong>{equipment}</strong></span>
                {
                  photoSet.data.tags.length > 0 && (
                    <span class="gallery-set-tags">
                      {photoSet.data.tags.map((tag) => <span>{tag}</span>)}
                    </span>
                  )
                }
              </span>
            </span>
          </button>

          <dialog
            id={dialogId}
            class="photo-set-dialog"
            aria-labelledby={dialogTitleId}
            aria-describedby={dialogDescriptionId}
            data-photo-set-dialog
            data-photo-set-hash={hashId}
          >
            <div class="photo-set-dialog-controls">
              <button class="photo-set-dialog-close" type="button" aria-label={`关闭套图：${photoSet.data.title}`} data-photo-set-close>
                <span aria-hidden="true">×</span>
              </button>
            </div>
            <article class="photo-set-dialog-content">
              <header class="photo-set-dialog-header">
                <p class="eyebrow">Image set / {String(photoSet.data.photos.length).padStart(2, "0")} frames</p>
                <h2 id={dialogTitleId}>{photoSet.data.title}</h2>
                <p id={dialogDescriptionId} class="photo-set-dialog-lead">{photoSet.data.description}</p>
                <div class="photo-set-dialog-facts">
                  <div>
                    <span>时间</span>
                    <time datetime={photoSet.data.date.toISOString()}>{formatDate(photoSet.data.date)}</time>
                  </div>
                  <div>
                    <span>地点</span>
                    <strong>{photoSet.data.location}</strong>
                  </div>
                  <div>
                    <span>设备</span>
                    <strong>{equipment}</strong>
                  </div>
                </div>
                {
                  photoSet.data.tags.length > 0 && (
                    <ul class="photo-set-dialog-tags" aria-label="套图标签">
                      {photoSet.data.tags.map((tag) => <li>{tag}</li>)}
                    </ul>
                  )
                }
              </header>

              <section class="photo-set-story-list" aria-label={`${photoSet.data.title} 的影像`}>
                {
                  photoSet.data.photos.map((photo, photoIndex) => (
                    <article
                      class:list={[
                        "photo-set-story-frame",
                        `is-${photo.aspect}`,
                        { "is-reversed": photoIndex % 2 === 1 }
                      ]}
                      data-dialog-reveal
                      style={`--dialog-reveal-delay: ${Math.min(photoIndex * 65, 195)}ms;`}
                    >
                      <button
                        class="photo-set-story-photo"
                        type="button"
                        aria-haspopup="dialog"
                        aria-label={`查看「${photo.alt}」大图`}
                        data-photo-lightbox-open
                        data-photo-lightbox-src={photo.image}
                        data-photo-lightbox-alt={photo.alt}
                      >
                        <img
                          src={photo.image}
                          alt={photo.alt}
                          width={photo.aspect === "portrait" ? 900 : 1200}
                          height={photo.aspect === "portrait" ? 1200 : 900}
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="photo-expand-mark" aria-hidden="true">⌕</span>
                      </button>
                    </article>
                  ))
                }
              </section>
            </article>
          </dialog>
        </li>
      );
    })
  }
</ol>

<dialog class="photo-lightbox" data-photo-lightbox aria-labelledby="photo-lightbox-title">
  <div class="photo-lightbox-frame">
    <p id="photo-lightbox-title" class="sr-only">大图预览</p>
    <button class="photo-lightbox-close" type="button" aria-label="关闭大图预览" data-photo-lightbox-close>
      <span aria-hidden="true">×</span>
    </button>
    <button
      class="photo-lightbox-image-button"
      type="button"
      aria-label="切换图片放大状态"
      aria-pressed="false"
      data-photo-lightbox-zoom
    >
      <img data-photo-lightbox-image alt="" width="1600" height="1200" decoding="async" />
      <span class="photo-lightbox-zoom-mark" aria-hidden="true">
        <span class="photo-lightbox-zoom-in">＋</span>
        <span class="photo-lightbox-zoom-out">−</span>
      </span>
    </button>
  </div>
</dialog>

<script>
  const initializePhotoSetDialogs = () => {
    const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-photo-set-open]"));
    const dialogs = Array.from(document.querySelectorAll<HTMLDialogElement>("[data-photo-set-dialog]"));
    const lightbox = document.querySelector<HTMLDialogElement>("[data-photo-lightbox]");
    const lightboxImage = lightbox?.querySelector<HTMLImageElement>("[data-photo-lightbox-image]");
    const lightboxZoomControl = lightbox?.querySelector<HTMLButtonElement>("[data-photo-lightbox-zoom]");
    const lightboxTriggers = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-photo-lightbox-open]"));
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const observers = new WeakMap<HTMLDialogElement, IntersectionObserver>();
    const triggerByDialog = new WeakMap<HTMLDialogElement, HTMLButtonElement>();

    const revealDialogFrames = (dialog: HTMLDialogElement) => {
      const frames = Array.from(dialog.querySelectorAll<HTMLElement>("[data-dialog-reveal]"));
      observers.get(dialog)?.disconnect();

      if (prefersReducedMotion.matches) {
        frames.forEach((frame) => frame.classList.add("is-visible"));
        return;
      }

      frames.forEach((frame) => frame.classList.remove("is-visible"));
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { root: dialog, threshold: 0.16 }
      );
      frames.forEach((frame) => observer.observe(frame));
      observers.set(dialog, observer);
    };

    const openDialog = (trigger: HTMLButtonElement, syncHash = true) => {
      const dialogId = trigger.dataset.dialogId;
      const dialog = dialogId ? document.getElementById(dialogId) : null;
      if (!(dialog instanceof HTMLDialogElement) || typeof dialog.showModal !== "function") return;

      triggerByDialog.set(dialog, trigger);
      if (!dialog.open) dialog.showModal();
      revealDialogFrames(dialog);

      const hashId = trigger.dataset.photoSetHash;
      if (syncHash && hashId && window.location.hash !== `#${hashId}`) {
        window.history.replaceState(null, "", `${window.location.pathname}${window.location.search}#${hashId}`);
      }
    };

    triggers.forEach((trigger) => trigger.addEventListener("click", () => openDialog(trigger)));

    dialogs.forEach((dialog) => {
      dialog.querySelector<HTMLButtonElement>("[data-photo-set-close]")?.addEventListener("click", () => dialog.close());

      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });

      dialog.addEventListener("close", () => {
        observers.get(dialog)?.disconnect();
        const hashId = dialog.dataset.photoSetHash;
        if (hashId && window.location.hash === `#${hashId}`) {
          window.history.replaceState(null, "", `${window.location.pathname}${window.location.search}`);
        }
        triggerByDialog.get(dialog)?.focus();
      });
    });

    if (lightbox && lightboxImage && lightboxZoomControl && typeof lightbox.showModal === "function") {
      let lightboxTrigger: HTMLButtonElement | undefined;

      const resetLightboxZoom = () => {
        lightboxZoomControl.setAttribute("aria-pressed", "false");
        lightboxZoomControl.style.removeProperty("--photo-zoom-x");
        lightboxZoomControl.style.removeProperty("--photo-zoom-y");
      };

      const closeLightbox = () => {
        if (lightbox.open) lightbox.close();
      };

      lightboxTriggers.forEach((trigger) => {
        trigger.addEventListener("click", () => {
          const src = trigger.dataset.photoLightboxSrc;
          const alt = trigger.dataset.photoLightboxAlt;
          if (!src) return;
          lightboxTrigger = trigger;
          resetLightboxZoom();
          lightboxImage.src = src;
          lightboxImage.alt = alt || "";
          if (!lightbox.open) lightbox.showModal();
        });
      });

      lightboxZoomControl.addEventListener("click", (event) => {
        const shouldZoom = lightboxZoomControl.getAttribute("aria-pressed") !== "true";

        if (shouldZoom) {
          const rect = lightboxZoomControl.getBoundingClientRect();
          const hasPointerPosition =
            event.clientX >= rect.left &&
            event.clientX <= rect.right &&
            event.clientY >= rect.top &&
            event.clientY <= rect.bottom;
          const zoomX = hasPointerPosition ? ((event.clientX - rect.left) / rect.width) * 100 : 50;
          const zoomY = hasPointerPosition ? ((event.clientY - rect.top) / rect.height) * 100 : 50;
          lightboxZoomControl.style.setProperty("--photo-zoom-x", `${Math.max(0, Math.min(100, zoomX))}%`);
          lightboxZoomControl.style.setProperty("--photo-zoom-y", `${Math.max(0, Math.min(100, zoomY))}%`);
        }

        lightboxZoomControl.setAttribute("aria-pressed", String(shouldZoom));
      });

      lightbox.querySelector<HTMLButtonElement>("[data-photo-lightbox-close]")?.addEventListener("click", closeLightbox);
      lightbox.addEventListener("click", (event) => {
        if (event.target === lightbox) closeLightbox();
      });
      lightbox.addEventListener("cancel", (event) => {
        event.preventDefault();
        closeLightbox();
      });
      lightbox.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          event.preventDefault();
          closeLightbox();
        }
      });
      lightbox.addEventListener("close", () => {
        resetLightboxZoom();
        lightboxImage.removeAttribute("src");
        lightboxImage.alt = "";
        lightboxTrigger?.focus();
      });
    }

    const openFromHash = () => {
      const hashId = decodeURIComponent(window.location.hash.replace(/^#/, ""));
      if (!hashId.startsWith("photo-set-")) return;
      const trigger = triggers.find((item) => item.dataset.photoSetHash === hashId);
      if (trigger) openDialog(trigger, false);
    };

    openFromHash();
    window.addEventListener("hashchange", openFromHash);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializePhotoSetDialogs, { once: true });
  } else {
    initializePhotoSetDialogs();
  }
</script>
