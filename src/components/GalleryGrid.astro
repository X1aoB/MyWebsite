---
import { getGalleryImage } from "../lib/gallery-images";
import "../styles/gallery.css";
import "../styles/gallery-navigation.css";

type PhotoAspect = "landscape" | "portrait" | "square";

interface GalleryPhoto {
  image: string;
  alt: string;
  caption: string;
  note?: string;
  aspect: PhotoAspect;
}

interface GallerySet {
  id: string;
  data: {
    title: string;
    date: Date;
    location: string;
    equipment: string;
    description: string;
    cover: {
      image: string;
      alt: string;
      aspect: PhotoAspect;
    };
    photos: GalleryPhoto[];
    tags: string[];
  };
}

interface Props {
  photoSets: GallerySet[];
}

const { photoSets } = Astro.props;
const images = new Map(await Promise.all(
  [...new Set(photoSets.flatMap((set) => [set.data.cover.image, ...set.data.photos.map((photo) => photo.image)]))]
    .map(async (source) => [source, await getGalleryImage(source)] as const)
));
const coverSizes = "(max-width: 760px) calc(100vw - 36px), (max-width: 1100px) 45vw, 400px";
const storySizes = "(max-width: 760px) calc((100vw - 76px) / 2), (max-width: 1080px) calc((100vw - 140px) / 3), 300px";
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "long", day: "numeric" }).format(date);
---

<ol class="gallery-set-grid" aria-label="摄影套图列表">
  {
    photoSets.map((photoSet, index) => {
      const dialogId = `photo-set-dialog-${photoSet.id.replace(/[^a-z0-9_-]/gi, "-")}`;
      const hashId = `photo-set-${photoSet.id.replace(/[^a-z0-9_-]/gi, "-")}`;
      const dialogTitleId = `${dialogId}-title`;
      const dialogDescriptionId = `${dialogId}-description`;
      const equipment = photoSet.data.equipment || "待补充";

      return (
        <li class="gallery-set-item" data-reveal style={`--reveal-delay: ${index * 75}ms;`}>
          <button
            id={hashId}
            class={`gallery-set-card ${photoSet.data.cover.aspect}`}
            type="button"
            aria-haspopup="dialog"
            aria-controls={dialogId}
            aria-label={`打开套图：${photoSet.data.title}`}
            data-photo-set-open
            data-dialog-id={dialogId}
            data-photo-set-hash={hashId}
          >
            <span class="gallery-set-cover">
              <img
                src={images.get(photoSet.data.cover.image)!.src}
                srcset={images.get(photoSet.data.cover.image)!.srcset}
                sizes={coverSizes}
                width={images.get(photoSet.data.cover.image)!.width}
                height={images.get(photoSet.data.cover.image)!.height}
                alt={photoSet.data.cover.alt}
                loading={index === 0 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : "auto"}
                decoding="async"
              />
              <span class="gallery-set-cover-wash" aria-hidden="true"></span>
              <span class="gallery-set-open" aria-hidden="true">
                <span>↗</span>
                <small>打开套图</small>
              </span>
            </span>
            <span class="gallery-set-copy">
              <span class="gallery-set-meta">
                <time datetime={photoSet.data.date.toISOString()}>{formatDate(photoSet.data.date)}</time>
                <span aria-hidden="true">·</span>
                <span>{photoSet.data.location}</span>
              </span>
              <strong>{photoSet.data.title}</strong>
              <span class="gallery-set-description">{photoSet.data.description}</span>
              <span class="gallery-set-footer">
                <span class="gallery-set-equipment"><span>设备</span><strong>{equipment}</strong></span>
                {
                  photoSet.data.tags.length > 0 && (
                    <span class="gallery-set-tags">
                      {photoSet.data.tags.map((tag) => <span>{tag}</span>)}
                    </span>
                  )
                }
              </span>
            </span>
          </button>

          <noscript>
            <details class="gallery-without-script">
              <summary>浏览这套摄影的 {photoSet.data.photos.length} 张照片</summary>
              <ol>
                {photoSet.data.photos.map((photo) => (
                  <li><a href={photo.image}>{photo.alt}</a></li>
                ))}
              </ol>
            </details>
          </noscript>

          <dialog
            id={dialogId}
            class="photo-set-dialog"
            aria-labelledby={dialogTitleId}
            aria-describedby={dialogDescriptionId}
            data-photo-set-dialog
            data-photo-set-hash={hashId}
          >
            <div class="photo-set-dialog-controls">
              <button class="photo-set-dialog-close" type="button" aria-label={`关闭套图：${photoSet.data.title}`} data-photo-set-close>
                <span aria-hidden="true">×</span>
              </button>
            </div>
            <article class="photo-set-dialog-content">
              <header class="photo-set-dialog-header">
                <p class="eyebrow">Image set / {String(photoSet.data.photos.length).padStart(2, "0")} frames</p>
                <h2 id={dialogTitleId}>{photoSet.data.title}</h2>
                <p id={dialogDescriptionId} class="photo-set-dialog-lead">{photoSet.data.description}</p>
                <div class="photo-set-dialog-facts">
                  <div>
                    <span>时间</span>
                    <time datetime={photoSet.data.date.toISOString()}>{formatDate(photoSet.data.date)}</time>
                  </div>
                  <div>
                    <span>地点</span>
                    <strong>{photoSet.data.location}</strong>
                  </div>
                  <div>
                    <span>设备</span>
                    <strong>{equipment}</strong>
                  </div>
                </div>
                {
                  photoSet.data.tags.length > 0 && (
                    <ul class="photo-set-dialog-tags" aria-label="套图标签">
                      {photoSet.data.tags.map((tag) => <li>{tag}</li>)}
                    </ul>
                  )
                }
              </header>

              <section class="photo-set-story-list" aria-label={`${photoSet.data.title} 的影像`}>
                {
                  photoSet.data.photos.map((photo, photoIndex) => (
                    <article
                      class:list={[
                        "photo-set-story-frame",
                        `is-${photo.aspect}`,
                        { "is-reversed": photoIndex % 2 === 1 }
                      ]}
                      data-dialog-reveal
                      style={`--dialog-reveal-delay: ${Math.min(photoIndex * 65, 195)}ms;`}
                    >
                      <button
                        class="photo-set-story-photo"
                        type="button"
                        aria-haspopup="dialog"
                        aria-label={`查看「${photo.alt}」大图`}
                        data-photo-lightbox-open
                        data-photo-lightbox-src={photo.image}
                        data-photo-lightbox-alt={photo.alt}
                        data-photo-width={images.get(photo.image)!.width}
                        data-photo-height={images.get(photo.image)!.height}
                      >
                        <img
                          data-photo-src={images.get(photo.image)!.src}
                          data-photo-srcset={images.get(photo.image)!.srcset}
                          sizes={storySizes}
                          alt={photo.alt}
                          width={images.get(photo.image)!.width}
                          height={images.get(photo.image)!.height}
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="photo-expand-mark" aria-hidden="true">⌕</span>
                      </button>
                    </article>
                  ))
                }
              </section>
            </article>
          </dialog>
        </li>
      );
    })
  }
</ol>

<dialog class="photo-lightbox" data-photo-lightbox data-no-translate aria-labelledby="photo-lightbox-title">
  <div class="photo-lightbox-frame">
    <p id="photo-lightbox-title" class="sr-only">大图预览</p>
    <button class="photo-lightbox-close" type="button" aria-label="关闭大图预览" data-photo-lightbox-close>
      <span aria-hidden="true">×</span>
    </button>
    <button
      class="photo-lightbox-image-button"
      type="button"
      aria-label="切换图片放大状态"
      aria-pressed="false"
      data-photo-lightbox-zoom
    >
      <img data-photo-lightbox-image alt="" width="1600" height="1200" decoding="async" />
      <span class="photo-lightbox-zoom-mark" aria-hidden="true">
        <span class="photo-lightbox-zoom-in">＋</span>
        <span class="photo-lightbox-zoom-out">−</span>
      </span>
    </button>
    <div class="photo-lightbox-navigation" aria-label="照片导航" data-photo-navigation>
      <button class="photo-lightbox-step" type="button" aria-label="上一张" data-photo-previous>
        <span aria-hidden="true">←</span><span data-photo-previous-label>上一张</span>
      </button>
      <output class="photo-lightbox-count" data-photo-count aria-live="polite" aria-atomic="true"></output>
      <button class="photo-lightbox-step" type="button" aria-label="下一张" data-photo-next>
        <span data-photo-next-label>下一张</span><span aria-hidden="true">→</span>
      </button>
    </div>
    <p class="photo-lightbox-feedback" data-photo-feedback hidden role="status"></p>
  </div>
</dialog>

<script>
  import { initializeGallery } from "../scripts/gallery";
  initializeGallery();
</script>
