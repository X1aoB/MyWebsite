---
import LocalizedText from "../components/LocalizedText.astro";
import { getCollection } from "astro:content";
import { now } from "../config/now";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getNowArticleSummaries, nowSectionUrl } from "../lib/now-pages";
import "../styles/now.css";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sections = now.sections.map((section) => ({ ...section, articleCount: getNowArticleSummaries(section, posts).length }));

const updatedAt = new Intl.DateTimeFormat("zh-CN", {
  timeZone: "Asia/Shanghai", year: "numeric", month: "long", day: "numeric"
}).format(new Date(now.updatedAt));

---

<BaseLayout title="Now" description="小B的日常分享、面试经历、技术文章与随机攻略。">
  <section class="now-page" data-now-page>
    <header class="discovery-hero" data-reveal>
      <div>
        <p class="eyebrow">Now / public notes</p>
        <h1>Now</h1>
        <p><LocalizedText {...now.intro} /></p>
      </div>
      <p class="discovery-updated">
        <span><LocalizedText zh="最近更新" en="Last updated" /></span>
        <time datetime={new Date(now.updatedAt).toISOString()}>{updatedAt}</time>
      </p>
    </header>

    <div class="now-categories">
      {sections.map((section, index) => (
        <article id={section.id} class="now-category">
          <a class="now-category-link" href={nowSectionUrl(section.slug)} data-now-section-link>
            <span class="now-category-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <span class="now-category-label"><LocalizedText {...section.label} /></span>
            <h2><LocalizedText {...section.title} /></h2>
            <span class="now-category-count"><LocalizedText zh={`${section.articleCount} 篇文章`} en={`${section.articleCount} ${section.articleCount === 1 ? "article" : "articles"}`} /></span>
            <span class="now-category-action" aria-hidden="true"><span class="now-category-symbol">↗</span><LocalizedText zh="进入" en="Explore" /></span>
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  import { initializeNowSections } from "../scripts/now-sections";
  initializeNowSections();
</script>
