---
import LocalizedText from "../components/LocalizedText.astro";
import { now } from "../config/now";
import BaseLayout from "../layouts/BaseLayout.astro";

const updatedAt = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric"
}).format(new Date(now.updatedAt));
---

<BaseLayout title="Now" description="小B当前正在推进、最近在玩和接下来准备做的事情。">
  <section class="now-page">
    <header class="discovery-hero" data-reveal>
      <div>
        <p class="eyebrow">Now / public note</p>
        <h1>Now</h1>
        <p><LocalizedText {...now.intro} /></p>
      </div>
      <p class="discovery-updated">
        <span><LocalizedText zh="最近更新" en="Last updated" /></span>
        <time datetime={new Date(now.updatedAt).toISOString()}>{updatedAt}</time>
      </p>
    </header>

    <div class="now-board">
      {
        now.sections.map((section, sectionIndex) => (
          <section id={section.id} class="now-section" data-reveal style={`--reveal-delay: ${sectionIndex * 90}ms;`}>
            <header>
              <p class="section-kicker"><LocalizedText {...section.label} /></p>
              <h2><LocalizedText {...section.title} /></h2>
            </header>
            <div class="now-item-list">
              {
                section.items.map((item) => (
                  <article class="now-item">
                    <h3><LocalizedText {...item.title} /></h3>
                    <p><LocalizedText {...item.description} /></p>
                    {
                      item.tags && item.tags.length > 0 && (
                        <ul class="now-tags" aria-label="相关标签">
                          {item.tags.map((tag) => <li>{tag}</li>)}
                        </ul>
                      )
                    }
                  </article>
                ))
              }
            </div>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>

