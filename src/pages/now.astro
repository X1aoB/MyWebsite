---
import LocalizedText from "../components/LocalizedText.astro";
import { now } from "../config/now";
import BaseLayout from "../layouts/BaseLayout.astro";

const updatedAt = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric"
}).format(new Date(now.updatedAt));

const formatItemDateTime = (date: string) =>
  new Intl.DateTimeFormat("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false
  }).format(new Date(date));
---

<BaseLayout title="Now" description="小B的日常分享、游戏讨论和项目灵感栏目。">
  <section class="now-page">
    <header class="discovery-hero" data-reveal>
      <div>
        <p class="eyebrow">Now / public note</p>
        <h1>Now</h1>
        <p><LocalizedText {...now.intro} /></p>
      </div>
      <p class="discovery-updated">
        <span><LocalizedText zh="最近更新" en="Last updated" /></span>
        <time datetime={new Date(now.updatedAt).toISOString()}>{updatedAt}</time>
      </p>
    </header>

    <div class="now-board">
      {
        now.sections.map((section, sectionIndex) => (
          <section
            id={section.id}
            class={`now-section ${section.items.length === 0 ? "now-section-empty" : ""}`}
            data-reveal
            style={`--reveal-delay: ${sectionIndex * 90}ms;`}
          >
            <header>
              {(section.label.zh || section.label.en) && <p class="section-kicker"><LocalizedText {...section.label} /></p>}
              <h2><LocalizedText {...section.title} /></h2>
            </header>
            {section.items.length > 0 && (
              <div class="now-item-list">
                {
                section.items.map((item) => (
                  <article class="now-item">
                    <time class="now-item-time" datetime={item.publishedAt}>{formatItemDateTime(item.publishedAt)}</time>
                    <h3><LocalizedText {...item.title} /></h3>
                    <p><LocalizedText {...item.description} /></p>
                  </article>
                ))
                }
              </div>
            )}
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>
