---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/project.css";
import Giscus from "../../components/Giscus.astro";
import LocalizedText from "../../components/LocalizedText.astro";
import { site } from "../../config/site";
import { projectSnow } from "../../config/project-snow";
import { xiaojiScreenshots, getXiaojiScreenshot } from "../../assets/xiaoji-terminal/screenshots";
import StatisticsPanel from "../../components/StatisticsPanel.astro";

const projectShots = await Promise.all(xiaojiScreenshots.map(async (shot) => ({ ...shot, image: await getXiaojiScreenshot(shot.src) })));
const fullScreenshotSizes = "(max-width: 760px) calc(100vw - 34px), (max-width: 1199px) calc(100vw - 254px), (max-width: 1536px) calc(95.4vw - 472px), 992px";
// The two supporting cards become columns once the main container reaches 620px.
const supportingScreenshotSizes = "(max-width: 651px) calc(100vw - 34px), (max-width: 760px) calc(50vw - 26.5px), (max-width: 871px) calc(100vw - 254px), (max-width: 1199px) calc(50vw - 136.5px), (max-width: 1536px) calc(47.7vw - 245.5px), 487px";

const startingSteps = [
  { title: { zh: "准备模型", en: "Connect a model" }, description: { zh: "选择受支持的模型服务，填写自己的 API Key。无需注册，模型费用由你的供应商账号承担。", en: "Choose a supported provider and enter your API key. No registration is needed; model usage is billed by your provider." } },
  { title: { zh: "认识角色", en: "Choose a character" }, description: { zh: "找到想聊天的角色，从一个话题、一句问候或一张表情开始。", en: "Find someone to talk to and begin with a topic, a greeting, or a sticker." } },
  { title: { zh: "让故事继续", en: "Keep the story going" }, description: { zh: "留在通讯器里续聊，或发出见面邀请，把对话接到面对面的场景中。", en: "Continue in the messenger or send an invitation to carry the conversation into a face-to-face scene." } }
];
---

<BaseLayout title="小吉终端" description={projectSnow.summary.zh + " 公开体验版本 " + projectSnow.publicVersion + "，最新进度更新于 " + projectSnow.updatedAt + "。"}>
  <article class="snow-page">
    <header class="snow-hero" data-reveal>
      <div class="snow-hero-meta">
        <p class="snow-kicker"><LocalizedText {...projectSnow.productName} /> / CHARACTER DIALOGUE</p>
        <span class="snow-live-badge"><span aria-hidden="true"></span><LocalizedText {...projectSnow.status} /></span>
      </div>
      <h1><LocalizedText {...projectSnow.productName} /></h1>
      <p class="snow-hero-intro"><LocalizedText {...projectSnow.intro} /></p>
      <p class="snow-hero-description"><LocalizedText {...projectSnow.summary} /></p>
      <div class="snow-actions">
        <a class="button" href={site.external.projectSnowPlay} target="_blank" rel="noreferrer"><LocalizedText zh="开始试玩 ↗" en="Play now ↗" /></a>
        <a class="button button-secondary" href="#snow-experience"><LocalizedText zh="先了解怎么玩 ↓" en="Explore the experience ↓" /></a>
      </div>
      <p class="snow-hero-note"><LocalizedText zh="无需注册 · 自备模型 API Key · 浏览器内保存聊天记录" en="No registration · Bring your own API key · Browser-local chat history" /></p>
      <nav class="snow-section-nav" aria-label="项目页章节" data-zh-label="项目页章节" data-en-label="Project page sections">
        <a href="#progress-title"><LocalizedText zh="最新进度" en="Latest progress" /><span aria-hidden="true">↗</span></a>
        <a href="#showcase-title"><LocalizedText zh="实机界面" en="Screenshots" /><span aria-hidden="true">↗</span></a>
        <a href="#snow-details"><LocalizedText zh="技术与说明" en="Technical details" /><span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <StatisticsPanel scope="project_snow" title={{ zh: "CHARACTER DIALOGUE · 延迟公开统计", en: "CHARACTER DIALOGUE · delayed public statistics" }} />

    <section class="snow-section" id="snow-experience" aria-labelledby="snow-experience-title">
      <div class="snow-section-heading" data-reveal>
        <p class="snow-kicker">01 / EXPERIENCE</p>
        <h2 id="snow-experience-title"><LocalizedText zh="两种相处方式，同一段日常。" en="Two ways to connect. One ongoing story." /></h2>
        <p><LocalizedText zh="先发一条消息，或者直接去见她。通讯与场景之间的切换，也保留着你们刚刚聊过的事。" en="Send a message or go meet her. Moving between the messenger and a scene keeps the context of your conversation." /></p>
      </div>
      <div class="snow-experiences">
        <article class="snow-experience" data-reveal>
          <div class="snow-experience-icon" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none"><path d="M8 8h24v18H18l-8 6v-6H8z"/><path d="M14 15h12M14 20h8"/></svg><span>TEXT</span></div>
          <h3><LocalizedText zh="文字通讯" en="Text communication" /></h3>
          <p><LocalizedText zh="用熟悉的聊天节奏，和角色保持联系。" en="Stay in touch through the familiar rhythm of a messenger." /></p>
          <ul>
            <li><LocalizedText zh="自由发起话题，用表情补足语气" en="Start a topic and add tone with stickers" /></li>
            <li><LocalizedText zh="回看本地记录，接着上次继续聊" en="Revisit local history and pick up where you left off" /></li>
            <li><LocalizedText zh="发出见面邀请，把通讯延伸到场景" en="Invite her to meet and move into a scene" /></li>
          </ul>
        </article>
        <article class="snow-experience" data-reveal>
          <div class="snow-experience-icon" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none"><path d="M7 9h26v23H7zM7 26h26"/><circle cx="20" cy="17" r="4"/><path d="M12 26c1-7 15-7 16 0"/></svg><span>SCENE</span></div>
          <h3><LocalizedText zh="面对面" en="Face to face" /></h3>
          <p><LocalizedText zh="走进 Galgame 式场景，让对白带上动作。" en="Step into a visual-novel-style scene where dialogue meets action." /></p>
          <ul>
            <li><LocalizedText zh="22 位角色立绘，各有 18 种基础表情" en="Artwork and 18 basic expressions for each of 22 characters" /></li>
            <li><LocalizedText zh="对白、动作与神情一起推动场景" en="Let dialogue, actions, and expressions shape the scene" /></li>
            <li><LocalizedText zh="邀请共同移动，让相处自然延续" en="Go somewhere together and continue the encounter" /></li>
          </ul>
        </article>
      </div>
      <p class="snow-shared-context" data-reveal><span aria-hidden="true">↔</span><LocalizedText zh="角色语境、记忆与地点贯穿两种体验。" en="Character context, memory, and location connect both experiences." /></p>
    </section>

    <section class="snow-section" aria-labelledby="progress-title">
      <div class="snow-section-heading snow-progress-heading" data-reveal>
        <div><p class="snow-kicker">02 / LATEST UPDATE</p><h2 id="progress-title"><LocalizedText zh="新名字，新界面，也有新的回应。" en="A new name, a new interface, and new ways to respond." /></h2></div>
        <time datetime={projectSnow.updatedAt}><LocalizedText zh="更新于" en="Updated" /> {projectSnow.updatedAt}</time>
      </div>
      <div class="snow-stages">
        {projectSnow.stages.map((stage) => (
          <article class={"snow-stage snow-stage-" + stage.id} data-reveal>
            <span class="snow-stage-status"><span aria-hidden="true"></span><LocalizedText {...stage.status} /></span>
            <div><h3><LocalizedText {...stage.title} /></h3><p><LocalizedText {...stage.description} /></p></div>
          </article>
        ))}
      </div>
      <a class="snow-text-link snow-progress-link" href="/journal/#journal-project-project-snow"><LocalizedText zh="在开发日志里查看项目记录" en="Follow the project in the dev logs" /><span aria-hidden="true">→</span></a>
    </section>

    <section class="snow-section" aria-labelledby="showcase-title">
      <div class="snow-section-heading" data-reveal>
        <p class="snow-kicker">03 / INSIDE THE TERMINAL</p>
        <h2 id="showcase-title"><LocalizedText zh="从消息，到见面。" en="From a message to a meeting." /></h2>
        <p><LocalizedText zh="五张实机截图，看看面对面、文字通讯、反馈、设置和公告在新版终端里如何连接。点击图片可查看完整原图。" en="Five screenshots show face-to-face scenes, messaging, feedback, settings, and announcements in the new terminal. Select an image to view the complete original." /></p>
      </div>
      <p class="snow-screenshot-note" data-reveal><strong>v{projectSnow.publicVersion}</strong><LocalizedText zh="当前版本实机界面 · 2026 年 9 月 9 日" en="Current version screenshots · September 9, 2026" /></p>
      <div class="project-showcase">
        {projectShots.map((shot, index) => (
          <article class={"project-shot project-shot-" + (index + 1)} data-reveal>
            <a class="project-shot-open" href={shot.src} target="_blank" rel="noreferrer" data-project-shot-open data-project-shot-src={shot.src} data-project-shot-width={shot.image.width} data-project-shot-height={shot.image.height} aria-label={"查看小吉终端完整截图：" + shot.title.zh} data-zh-label={"查看小吉终端完整截图：" + shot.title.zh} data-en-label={"View full Xiaoji Terminal screenshot: " + shot.title.en}>
              <img src={shot.image.src} srcset={shot.image.srcset} sizes={index === 2 || index === 3 ? supportingScreenshotSizes : fullScreenshotSizes} alt={shot.alt.zh} data-zh-alt={shot.alt.zh} data-en-alt={shot.alt.en} width={shot.image.width} height={shot.image.height} loading="lazy" decoding="async" />
              <span class="project-shot-zoom" aria-hidden="true">↗</span>
            </a>
            <div class="project-shot-copy"><span class="project-shot-type"><span aria-hidden="true">0{index + 1} / </span><LocalizedText {...shot.type} /></span><h3><LocalizedText {...shot.title} /></h3><p><LocalizedText {...shot.description} /></p></div>
          </article>
        ))}
      </div>
    </section>

    <section class="snow-section" aria-labelledby="snow-start-title">
      <div class="snow-section-heading" data-reveal><p class="snow-kicker">04 / GET STARTED</p><h2 id="snow-start-title"><LocalizedText zh="用三步，开始第一次对话。" en="Three steps to your first conversation." /></h2></div>
      <ol class="snow-start-steps">
        {startingSteps.map((step, index) => <li data-reveal><span class="snow-step-number" aria-hidden="true">0{index + 1}</span><div><h3><LocalizedText {...step.title} /></h3><p><LocalizedText {...step.description} /></p></div></li>)}
      </ol>
    </section>

    <section class="snow-section" id="snow-details" aria-labelledby="snow-details-title">
      <div class="snow-section-heading" data-reveal><p class="snow-kicker">05 / TECHNOLOGY & DATA</p><h2 id="snow-details-title"><LocalizedText zh="技术、数据与许可，完整说明。" en="Technology, data, and licensing." /></h2><p><LocalizedText zh="角色体验由什么构成、记录保存在哪里，以及资料与素材的使用方式。" en="What powers the character experience, where records are kept, and how sources and assets are used." /></p></div>
      <div class="snow-details">
        <article class="snow-detail-card" aria-labelledby="snow-technology-title" data-reveal>
          <header><span class="snow-detail-marker" aria-hidden="true">01</span><h3 id="snow-technology-title"><LocalizedText zh="技术栈与角色记忆" en="Technology and character memory" /></h3></header>
          <div class="snow-detail-body">
            <div class="snow-technology">
              <div><h4><LocalizedText zh="界面与本地状态" en="Interface and local state" /></h4><p><LocalizedText zh="原生 HTML、CSS 与 JavaScript ES Modules 构成终端界面，SSE 将模型回复逐步送回页面。IndexedDB 保存聊天记录、摘要、草稿与收藏，让通讯和面对面可以衔接同一段经历。" en="HTML, CSS, and JavaScript ES Modules power the terminal, with SSE streaming model replies. IndexedDB keeps chat history, summaries, drafts, and favorites so messaging and face-to-face scenes can continue the same story." /></p></div>
              <div><h4><LocalizedText zh="服务与模型连接" en="Services and model connections" /></h4><p><LocalizedText zh="Python 与 FastAPI 提供服务，配合 Pydantic、HTTPX 等组件处理请求与模型响应。公开体验支持 OpenAI、DeepSeek、阿里云百炼、智谱和 Moonshot，用户选择自己的服务商与模型。" en="Python and FastAPI provide services, with components such as Pydantic and HTTPX handling requests and model responses. The public experience supports OpenAI, DeepSeek, Alibaba Cloud Model Studio, Zhipu, and Moonshot, with users choosing their provider and model." /></p></div>
              <div><h4><LocalizedText zh="资料检索与人物关系" en="Source retrieval and relationships" /></h4><p><LocalizedText zh="角色回应结合公开 Wiki 资料、人物关系与当前场景。SQLite FTS5 全文检索与本地向量召回共同寻找相关资料，Qdrant 承载向量检索，Neo4j 保存人物与剧情关系；检索结果为模型补充语境。" en="Replies draw on public Wiki material, relationships, and the current scene. SQLite FTS5 full-text search and local vector retrieval find relevant sources, with Qdrant serving vector search and Neo4j storing character and story relationships. Retrieved material adds context for the model." /></p></div>
            </div>
            <div class="snow-tech-list"><span>FastAPI</span><span>JavaScript</span><span>IndexedDB</span><span>SSE</span><span>SQLite FTS5</span><span>Qdrant</span><span>Neo4j</span></div>
            <a class="snow-text-link" href={site.repositories.projectSnow} target="_blank" rel="noreferrer"><LocalizedText zh="在 GitHub 查看源码 ↗" en="Explore the source on GitHub ↗" /></a>
          </div>
        </article>
        <article class="snow-detail-card" aria-labelledby="snow-data-title" data-reveal>
          <header><span class="snow-detail-marker" aria-hidden="true">02</span><h3 id="snow-data-title"><LocalizedText zh="模型费用、记录与数据处理" en="Model costs, records, and data handling" /></h3></header>
          <div class="snow-detail-body">
            <dl class="snow-data-facts">
              <div><dt><LocalizedText zh="模型与费用" en="Models & costs" /></dt><dd><LocalizedText zh="无需注册，自备受支持模型服务的 API Key。对话内容会发送给所选服务商生成回复，模型调用费用由对应供应商账号承担。" en="No registration is needed. Bring an API key for a supported provider. Conversation content is sent to that provider to generate replies, and model usage is billed to your provider account." /></dd></div>
              <div><dt><LocalizedText zh="API Key" en="API key" /></dt><dd><LocalizedText zh="Key 经服务器内存转发，不写入数据库、磁盘、反馈或日志。加密凭证只保留在当前标签页，最长有效 12 小时；获取模型列表和切换角色无需重新填写。" en="The key is forwarded through server memory and is not written to the database, disk, feedback, or logs. The encrypted credential stays in the current tab for up to 12 hours; listing models or switching characters does not require re-entry." /></dd></div>
              <div><dt><LocalizedText zh="聊天记录" en="Chat history" /></dt><dd><LocalizedText zh="聊天、摘要、草稿与收藏以明文保存在当前浏览器，不会自动跨设备同步。可以在记录管理中回看或清理，共享设备上的记录也需要自行清理。" en="Chats, summaries, drafts, and favorites are stored as plaintext in the current browser and do not automatically sync across devices. Review or clear them through history management, including after using a shared device." /></dd></div>
              <div><dt><LocalizedText zh="反馈与联系" en="Feedback & contact" /></dt><dd><LocalizedText zh="提交前可以预览或取消附带的一问一答与请求编号。QQ 完全可选并加密保存，随反馈在 30 天后删除；反馈内容与完整清理规则见公开说明。" en="Preview or remove the attached question, answer, and request ID before submitting feedback. QQ is entirely optional, encrypted, and deleted with the feedback after 30 days. The public notice explains the full handling and deletion rules." /></dd></div>
            </dl>
            <a class="snow-text-link" href={site.external.projectSnowPrivacy} target="_blank" rel="noreferrer"><LocalizedText zh="阅读完整隐私与素材说明 ↗" en="Read the full privacy and asset notice ↗" /></a>
          </div>
        </article>
        <article class="snow-detail-card" aria-labelledby="snow-license-title" data-reveal>
          <header><span class="snow-detail-marker" aria-hidden="true">03</span><h3 id="snow-license-title"><LocalizedText zh="资料来源与开源许可" en="Sources and open-source licensing" /></h3></header>
          <div class="snow-detail-body">
            <p><LocalizedText zh="小吉终端是基于《尘白禁区》公开 Wiki 资料的非官方、非商业项目，不代表游戏官方。知识资料、头像与表情按固定来源修订记录署名、许可依据与处理方式，具体页面的特殊声明优先。" en="Xiaoji Terminal is an unofficial, non-commercial project based on public Snowbreak Wiki material and is not affiliated with the game. Knowledge sources, avatars, and stickers record attribution, license basis, and transformations against fixed source revisions, with page-specific notices taking priority." /></p>
            <p><LocalizedText zh="公开署名索引用于说明资料从哪里来、经过哪些处理；它不代表项目已确认原始游戏美术的全部权属，也不构成额外授权。模型生成的对话可能偏离原作设定。" en="The public attribution index documents source material and its processing. It does not establish ownership of all original game artwork or grant additional rights. Model-generated dialogue may differ from canon." /></p>
            <dl class="snow-license-links">
              <div><dt><LocalizedText zh="资料来源" en="Source" /></dt><dd><a href={site.external.bWiki} target="_blank" rel="noreferrer">BWiki ↗</a></dd></div>
              <div><dt><LocalizedText zh="逐项署名" en="Attribution" /></dt><dd><a href={site.external.projectSnowPlay + "public/v1/attributions"} target="_blank" rel="noreferrer"><LocalizedText zh="公开署名 JSON ↗" en="Public attribution JSON ↗" /></a></dd></div>
              <div><dt><LocalizedText zh="数据许可" en="Data license" /></dt><dd><a href={site.external.ccByNcSa} target="_blank" rel="noreferrer">CC BY-NC-SA 4.0 ↗</a></dd></div>
              <div><dt><LocalizedText zh="代码许可" en="Code license" /></dt><dd><a href={site.repositories.projectSnow} target="_blank" rel="noreferrer">GPL-3.0-only ↗</a></dd></div>
            </dl>
          </div>
        </article>
      </div>
    </section>

    <footer class="snow-play-panel" data-reveal>
      <span class="snow-kicker"><LocalizedText {...projectSnow.status} /></span>
      <h2><LocalizedText zh="下一句，由你开始。" en="The next line is yours." /></h2>
      <p><LocalizedText zh="准备好 API Key，去和一位角色打个招呼。模型生成内容可能偏离原作；使用前可以先了解隐私与素材说明。" en="Bring your API key and say hello to a character. Model-generated content may differ from canon; the privacy and asset notice explains the experience in more detail." /></p>
      <div class="snow-actions"><a class="button" href={site.external.projectSnowPlay} target="_blank" rel="noreferrer"><LocalizedText zh="打开小吉终端 ↗" en="Open Xiaoji Terminal ↗" /></a><a class="snow-text-link" href={site.external.projectSnowPrivacy} target="_blank" rel="noreferrer"><LocalizedText zh="隐私与素材 ↗" en="Privacy & assets ↗" /></a></div>
    </footer>
  </article>

  <dialog class="project-shot-lightbox" data-project-shot-lightbox aria-labelledby="project-shot-lightbox-title">
    <div class="project-shot-lightbox-frame">
      <div class="project-shot-lightbox-bar"><span id="project-shot-lightbox-title"><LocalizedText zh="小吉终端 · 完整截图" en="Xiaoji Terminal · Full screenshot" /></span><button type="button" data-project-shot-close aria-label="关闭大图预览" data-zh-label="关闭大图预览" data-en-label="Close screenshot preview">×</button></div>
      <figure><img data-project-shot-image alt="" width="2559" height="1326" /><figcaption data-project-shot-caption></figcaption></figure>
    </div>
  </dialog>

  <Giscus />
</BaseLayout>

<script>
  const lightbox = document.querySelector<HTMLDialogElement>("[data-project-shot-lightbox]");
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>("[data-project-shot-image]");
  const lightboxCaption = lightbox?.querySelector<HTMLElement>("[data-project-shot-caption]");
  const shotTriggers = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-project-shot-open]"));
  let activeTrigger: HTMLAnchorElement | undefined;

  const syncScreenshotLanguage = () => {
    const english = document.documentElement.lang.startsWith("en");
    document.querySelectorAll<HTMLElement>(".snow-page [data-zh-label], .project-shot-lightbox [data-zh-label]").forEach((element) => {
      element.setAttribute("aria-label", (english ? element.dataset.enLabel : element.dataset.zhLabel) || "");
    });
    document.querySelectorAll<HTMLImageElement>(".project-shot img[data-zh-alt]").forEach((image) => {
      image.alt = (english ? image.dataset.enAlt : image.dataset.zhAlt) || "";
    });
    if (lightbox?.open && activeTrigger && lightboxImage && lightboxCaption) {
      lightboxImage.alt = activeTrigger.querySelector("img")?.alt || "";
      lightboxCaption.textContent = activeTrigger.closest(".project-shot")?.querySelector<HTMLElement>(".project-shot-copy p")?.textContent?.trim() || "";
    }
  };
  syncScreenshotLanguage();
  window.addEventListener("site-locale-change", syncScreenshotLanguage);

  const closeLightbox = () => {
    if (lightbox?.open) lightbox.close();
  };

  if (lightbox && lightboxImage && lightboxCaption && typeof lightbox.showModal === "function") {
    shotTriggers.forEach((trigger) => {
      trigger.setAttribute("aria-haspopup", "dialog");
      trigger.addEventListener("click", (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        const src = trigger.dataset.projectShotSrc;
        if (!src) return;
        event.preventDefault();
        activeTrigger = trigger;
        lightboxImage.src = src;
        lightboxImage.alt = trigger.querySelector("img")?.alt || "";
        lightboxImage.width = Number(trigger.dataset.projectShotWidth);
        lightboxImage.height = Number(trigger.dataset.projectShotHeight);
        lightboxCaption.textContent = trigger.closest(".project-shot")?.querySelector<HTMLElement>(".project-shot-copy p")?.textContent?.trim() || "";
        if (!lightbox.open) lightbox.showModal();
      });
    });

    lightbox.querySelector<HTMLButtonElement>("[data-project-shot-close]")?.addEventListener("click", closeLightbox);
    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) closeLightbox();
    });
    lightbox.addEventListener("close", () => {
      lightboxImage.removeAttribute("src");
      lightboxImage.alt = "";
      lightboxCaption.textContent = "";
      activeTrigger?.focus({ preventScroll: true });
    });
  }
</script>
