---
import { getImage } from "astro:assets";
import Icon from "../../components/Icon.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/project.css";
import Giscus from "../../components/Giscus.astro";
import LocalizedText from "../../components/LocalizedText.astro";
import XiaojiShot from "../../components/XiaojiShot.astro";
import { site } from "../../config/site";
import { projectSnow } from "../../config/project-snow";
import type { XiaojiShotId } from "../../assets/xiaoji-terminal/screenshots";
import promoCover from "../../assets/xiaoji-terminal/promo-cover.jpg";
import StatisticsPanel from "../../components/StatisticsPanel.astro";
import ReadingToc from "../../components/ReadingToc.astro";
import type { IconName } from "../../lib/icons";

type Copy = { zh: string; en: string };

const { promo } = projectSnow;

const pageSections = [
  { depth: 2, slug: "xj-features-title", text: { zh: "特色", en: "Features" } },
  { depth: 2, slug: "xj-day-title", text: { zh: "九个地点", en: "Nine places" } },
  { depth: 2, slug: "xj-phone-title", text: { zh: "手机版", en: "On your phone" } },
  { depth: 2, slug: "xj-updates-title", text: { zh: "近期更新", en: "Recent updates" } },
  { depth: 2, slug: "xj-start-title", text: { zh: "三步开始", en: "Get started" } },
  { depth: 2, slug: "snow-details-title", text: { zh: "技术与说明", en: "Technical details" } },
  { depth: 2, slug: "comments-title", text: { zh: "讨论", en: "Discussion" } }
];

// The main column: full width below 761px, beside the sidebar up to 1199px, beside sidebar and rail above.
const fullSizes = "(max-width: 760px) calc(100vw - 34px), (max-width: 1199px) calc(100vw - 254px), (max-width: 1536px) calc(95.4vw - 472px), 992px";
const featureSizes = "(max-width: 760px) calc(100vw - 34px), (max-width: 1199px) calc(100vw - 254px), (max-width: 1536px) calc(52vw - 260px), 560px";
const halfSizes = "(max-width: 559px) calc(100vw - 34px), (max-width: 760px) calc(50vw - 24px), (max-width: 1199px) calc(50vw - 134px), (max-width: 1536px) calc(47.7vw - 245px), 487px";
const phoneSizes = "(max-width: 760px) 62vw, 300px";
const insetSizes = "(max-width: 760px) 28vw, 160px";

const cover = await getImage({ src: promoCover, widths: [640, 960, 1280, 1920, 2560], format: "webp", quality: 78 });
const coverFallback = cover.srcSet.values.find((candidate) => candidate.descriptor === "1280w")?.url ?? cover.src;

const heroFacts: { value: string; label: Copy }[] = [
  { value: "22", label: { zh: "位角色", en: "characters" } },
  { value: "18", label: { zh: "种基础表情", en: "basic expressions each" } },
  { value: "9", label: { zh: "个地点场景", en: "location scenes" } },
  { value: "4", label: { zh: "个时段", en: "times of day" } }
];

const features: { icon: IconName; type: Copy; title: Copy; description: Copy; points: Copy[]; shot: XiaojiShotId; inset?: XiaojiShotId }[] = [
  {
    icon: "users-round",
    type: { zh: "面对面", en: "Face to face" },
    title: { zh: "像 Galgame 一样，见到她", en: "Meet her like in a visual novel" },
    description: { zh: "走进她所在的地点，全屏舞台上是她的立绘、神情与对白。说一句话、写下一个动作，场景就随你们的相处继续。", en: "Step into the place where she is: her artwork, expressions, and lines fill a full-screen stage. Say something or describe an action, and the scene carries on with you." },
    points: [
      { zh: "22 位角色，每位 18 种基础表情", en: "22 characters with 18 basic expressions each" },
      { zh: "长台词按对白框分页，可自动翻页、回看与跳过", en: "Long lines are paged, with auto-advance, backlog, and skip" },
      { zh: "邀请她一起去别处，她同意后就同行", en: "Invite her somewhere and go together once she agrees" }
    ],
    shot: "bubu-night"
  },
  {
    icon: "message-square-text",
    type: { zh: "文字通讯", en: "Messaging" },
    title: { zh: "消息，一条一条地来", en: "Messages that arrive one by one" },
    description: { zh: "先显示正在输入，再逐条送达完整的气泡。用文字和表情包聊日常；想见面时，点「去见她」就能走进她所在的地方。", en: "A typing indicator first, then each bubble in full. Chat about your day with text and stickers; when you want to meet, Meet her takes you to where she is." },
    points: [
      { zh: "聊天记录、摘要和草稿保存在你的浏览器", en: "Chats, summaries, and drafts stay in your browser" },
      { zh: "原作回忆、日常和你们的共同经历分开理解", en: "Memories from the game, everyday talk, and your shared history are kept apart" },
      { zh: "每轮回复显示模型调用次数和 token", en: "Every reply shows its model calls and tokens" }
    ],
    shot: "enya-messenger"
  },
  {
    icon: "map",
    type: { zh: "基地地图", en: "Base map" },
    title: { zh: "她此刻在基地哪里", en: "Where she is on the base right now" },
    description: { zh: "在基地平面图上看 22 位角色此刻所在的房间和正在做的事。点一个房间看谁在那里，选中她，就能沿着平常的路线去见她。", en: "See which room each of the 22 characters is in and what she is doing on the base floor plan. Pick a room to see who is there, then go and meet her." },
    points: [
      { zh: "每位角色 8 种日常活动，分布在基地各处", en: "Eight daily activities per character, spread across the base" },
      { zh: "打开地图不刷新场景，也不调用模型", en: "Opening the map neither refreshes the scene nor calls the model" }
    ],
    shot: "base-map"
  },
  {
    icon: "book-heart",
    type: { zh: "记忆档案", en: "Memory archive" },
    title: { zh: "她记得你说过的话", en: "She remembers what you said" },
    description: { zh: "你说过的话、你们一起经历的事和她答应过的事，都可以在「她记得的事」里查看、筛选和删除；删掉的一条，之后的对话不会再用到。", en: "What you told her, what you did together, and what she promised are all in What she remembers, where you can filter and delete them; a deleted entry is never used again." },
    points: [
      { zh: "收藏喜欢的台词，在回看里搜索全部记录", en: "Favourite lines and search your whole history" },
      { zh: "在本机生成雪白、暮色、夜色三种底色的图片卡", en: "Make quote cards in snow, dusk, or night tones on your device" },
      { zh: "记忆只保存在这个浏览器里", en: "Memories stay in this browser" }
    ],
    shot: "memory-archive"
  },
  {
    icon: "bell-ring",
    type: { zh: "约定与提醒", en: "Plans & reminders" },
    title: { zh: "到点了，她会来找你", en: "When it is time, she comes to find you" },
    description: { zh: "邀请她时可以设 30 分钟后、1 小时后或指定时间提醒。到点后，通讯器顶部和手机锁屏都会出现提醒卡，可以直接去见她，或 10 分钟后再提醒。", en: "When you invite her, set a reminder for 30 minutes, an hour, or a set time. When it is due, a card appears at the top of the messenger and on the phone lock screen: go and meet her, or snooze for 10 minutes." },
    points: [
      { zh: "可以开启「角色主动来消息」，她会用平时对你的称呼发来一条消息", en: "Optionally let her message you first, using how she usually addresses you" },
      { zh: "主动消息默认关闭，每条调用一次模型，每天最多 3 条", en: "Off by default; each message is one model call, at most three a day" },
      { zh: "提醒只在页面开着时出现，本身不调用模型", en: "Reminders appear only while the page is open and make no model call" }
    ],
    shot: "reminder-setup",
    inset: "phone-lock"
  }
];

const dayParts: { time: Copy; place: Copy; shot: XiaojiShotId }[] = [
  { time: { zh: "清晨", en: "Dawn" }, place: { zh: "B-04 基地休息区 · 辰星", en: "B-04 rest area" }, shot: "chenxing-morning" },
  { time: { zh: "白天", en: "Day" }, place: { zh: "公园 · 肴", en: "The park" }, shot: "yao-park-day" },
  { time: { zh: "黄昏", en: "Dusk" }, place: { zh: "暮色通讯器 · 里芙", en: "The messenger in dusk tones" }, shot: "lifu-dusk" },
  { time: { zh: "夜晚", en: "Night" }, place: { zh: "基地温泉 · 凯茜娅", en: "The base hot spring" }, shot: "kaixiya-onsen" }
];

const places: Copy[] = [
  { zh: "基地海滩", en: "Base beach" },
  { zh: "基地温泉", en: "Hot spring" },
  { zh: "基地游戏厅", en: "Arcade" },
  { zh: "基地酒吧", en: "Bar" },
  { zh: "基地疗愈中心", en: "Healing centre" },
  { zh: "公园", en: "Park" },
  { zh: "商业街", en: "Shopping street" },
  { zh: "购物中心", en: "Mall" },
  { zh: "分析员的房间", en: "Your room" }
];

const phoneShots: { label: Copy; shot: XiaojiShotId }[] = [
  { label: { zh: "通讯器与提醒卡", en: "Messenger and reminder" }, shot: "phone-messenger" },
  { label: { zh: "面对面", en: "Face to face" }, shot: "phone-face" },
  { label: { zh: "基地地图", en: "Base map" }, shot: "phone-map" }
];

const startingSteps = [
  { title: { zh: "连接模型", en: "Connect a model" }, description: { zh: "选择 OpenAI、DeepSeek、阿里云百炼、智谱或 Moonshot，填写自己的 API Key；也可以连接个人 Codex 订阅。无需注册，费用由你的服务商账号或订阅承担。", en: "Choose OpenAI, DeepSeek, Alibaba Cloud Model Studio, Zhipu, or Moonshot and enter your own API key, or connect a personal Codex subscription. No registration; usage is billed to your provider account or subscription." } },
  { title: { zh: "选一位角色", en: "Choose a character" }, description: { zh: "在通讯器里找到想聊天的人，从一句问候、一个话题或一张表情包开始。", en: "Find someone in the messenger and start with a greeting, a topic, or a sticker." } },
  { title: { zh: "去见她", en: "Go and meet her" }, description: { zh: "点「去见她」走进她所在的地点；或者约好时间，到点后她会提醒你。", en: "Press Meet her to step into her location, or make a plan and let her remind you when it is time." } }
];
---

<BaseLayout title="小吉终端" description={projectSnow.summary.zh + " 当前版本 " + projectSnow.publicVersion + "，宣传片已在哔哩哔哩发布。"}>
  <article class="xj-page snow-page">
    <header class="xj-hero">
      <div class="xj-film" data-promo data-promo-bvid={promo.bvid}>
        <div class="xj-film-stage" data-promo-stage>
          <img class="xj-film-poster" src={coverFallback} srcset={cover.srcSet.attribute} sizes={fullSizes} width={promoCover.width} height={promoCover.height} alt="小吉终端 1.0.0 宣传片片头：飘雪的夜空下，晶体世界树前写着「小吉终端 1.0.0 正式上线」" data-zh-alt="小吉终端 1.0.0 宣传片片头：飘雪的夜空下，晶体世界树前写着「小吉终端 1.0.0 正式上线」" data-en-alt="The opening of the Xiaoji Terminal 1.0.0 film: “Xiaoji Terminal 1.0.0 is live” in front of a crystal tree under falling snow" loading="eager" fetchpriority="high" decoding="async" />
          <video class="xj-film-preview" data-promo-preview muted playsinline loop preload="none" width="1280" height="720" aria-hidden="true" tabindex="-1">
            <source src="/media/xiaoji-terminal/promo-preview-1.0.0.mp4" type="video/mp4" />
          </video>
          <span class="xj-film-shade" aria-hidden="true"></span>
          <span class="xj-film-badge"><span aria-hidden="true"></span><LocalizedText zh="静音预览 · 17 秒" en="Muted preview · 17 s" /></span>
          <a class="xj-film-play" href={promo.url} target="_blank" rel="noreferrer" data-promo-play>
            <span class="xj-film-play-icon" aria-hidden="true"><Icon name="play" /></span>
            <span class="xj-film-play-copy"><strong><LocalizedText zh="播放完整宣传片" en="Play the full film" /></strong><small>{promo.duration} · <LocalizedText zh="哔哩哔哩" en="Bilibili" /></small></span>
          </a>
          <button class="xj-film-toggle" type="button" data-promo-toggle data-state="paused" hidden>
            <span class="xj-film-toggle-icon xj-film-toggle-pause" aria-hidden="true"><Icon name="pause" /></span>
            <span class="xj-film-toggle-icon xj-film-toggle-play" aria-hidden="true"><Icon name="play" /></span>
            <span class="sr-only"><LocalizedText zh="播放预览" en="Play preview" /></span>
          </button>
        </div>
        <p class="xj-film-caption">
          <span class="xj-film-title"><Icon name="bilibili" /> <cite><LocalizedText {...promo.title} /></cite></span>
          <span class="xj-film-meta">{promo.duration} · <time datetime={promo.publishedAt}>{promo.publishedAt}</time> <LocalizedText zh="发布" en="published" /></span>
        </p>
        <p class="xj-film-note"><LocalizedText zh="静音预览由本站提供。点「播放完整宣传片」会在本页加载哔哩哔哩播放器，之后的播放数据由哔哩哔哩处理；也可以直接去 B 站观看。" en="The muted preview is served by this site. Play the full film loads Bilibili's player on this page, after which Bilibili handles playback data; you can also watch it on Bilibili." /></p>
      </div>

      <div class="xj-hero-copy">
        <div class="xj-hero-meta">
          <p class="snow-kicker">SNOWBREAK FAN COMPANION</p>
          <span class="snow-live-badge"><span aria-hidden="true"></span><LocalizedText {...projectSnow.status} /></span>
        </div>
        <h1 id="project-title"><LocalizedText {...projectSnow.productName} /> <span class="xj-version">{projectSnow.publicVersion}</span></h1>
        <p class="xj-hero-intro"><LocalizedText {...projectSnow.intro} /></p>
        <p class="xj-hero-description"><LocalizedText {...projectSnow.summary} /></p>
        <div class="snow-actions">
          <a class="button" href={site.external.projectSnowPlay} target="_blank" rel="noreferrer"><LocalizedText zh="开始体验" en="Start now" /> <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a>
          <a class="button button-secondary" href={promo.url} target="_blank" rel="noreferrer"><span aria-hidden="true"><Icon name="bilibili" /></span> <LocalizedText zh="在 B 站看宣传片" en="Watch on Bilibili" /> <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a>
        </div>
        <ul class="xj-hero-facts">
          {heroFacts.map((fact) => <li><strong>{fact.value}</strong><LocalizedText {...fact.label} /></li>)}
        </ul>
        <p class="snow-hero-note"><LocalizedText zh="无需注册 · 自备模型 API Key 或个人 Codex 订阅 · 聊天记录保存在浏览器 · 电脑和手机浏览器都能用" en="No registration · Bring your own API key or Codex subscription · Chats stay in your browser · Desktop and mobile browsers" /></p>
      </div>
    </header>

    <section class="snow-section" id="xj-features" aria-labelledby="xj-features-title">
      <div class="snow-section-heading" data-reveal>
        <p class="snow-kicker">01 / FEATURES</p>
        <h2 id="xj-features-title"><LocalizedText zh="发一条消息，或者直接去见她。" en="Send her a message, or go and meet her." /></h2>
        <p><LocalizedText zh="文字通讯和面对面共享同一段记忆与地点：在通讯器里约好的事，见面时她还记得。以下截图全部来自线上正式版的真实对话，点击可查看原图。" en="Messaging and face-to-face scenes share one memory and one sense of place: what you plan in the messenger, she still remembers when you meet. Every screenshot comes from a real conversation on the live site; select one to see it in full." /></p>
      </div>
      <div class="xj-features">
        {features.map((feature, index) => (
          <article class:list={["xj-feature", { "xj-feature-reverse": index % 2 === 1 }]} data-reveal>
            <div class:list={["xj-feature-media", { "xj-feature-media-inset": feature.inset }]}>
              <XiaojiShot id={feature.shot} sizes={featureSizes} />
              {feature.inset && <XiaojiShot id={feature.inset} sizes={insetSizes} class="xj-shot-inset" />}
            </div>
            <div class="xj-feature-copy">
              <p class="xj-feature-type"><span class="xj-feature-icon" aria-hidden="true"><Icon name={feature.icon} strokeWidth={1.6} /></span><span aria-hidden="true">0{index + 1} · </span><LocalizedText {...feature.type} /></p>
              <h3><LocalizedText {...feature.title} /></h3>
              <p><LocalizedText {...feature.description} /></p>
              <ul>{feature.points.map((point) => <li><LocalizedText {...point} /></li>)}</ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="snow-section" id="xj-day" aria-labelledby="xj-day-title">
      <div class="snow-section-heading" data-reveal>
        <p class="snow-kicker">02 / FROM DAWN TO NIGHT</p>
        <h2 id="xj-day-title"><LocalizedText zh="九个地点，从清晨到深夜。" en="Nine places, from dawn to late night." /></h2>
        <p><LocalizedText zh="每个地点都有自己的背景，并随清晨、白天、黄昏、夜晚变化，界面也跟着从雪白变成暮色、夜色。一起去别处时，她先把话说完，再由白雪盖满画面，揭开新的地点。" en="Every location has its own backdrop that shifts through dawn, day, dusk, and night, and the interface moves from snow white to dusk and night tones with it. When you go somewhere together, she finishes her line, then snow covers the screen and opens on the new place." /></p>
      </div>
      <ol class="xj-day">
        {dayParts.map((part) => (
          <li data-reveal>
            <figure>
              <XiaojiShot id={part.shot} sizes={halfSizes} />
              <figcaption><strong><LocalizedText {...part.time} /></strong><span><LocalizedText {...part.place} /></span></figcaption>
            </figure>
          </li>
        ))}
      </ol>
      <ul class="xj-places" aria-label="九个地点" data-zh-label="九个地点" data-en-label="Nine places" data-reveal>
        {places.map((place) => <li><LocalizedText {...place} /></li>)}
      </ul>
    </section>

    <section class="snow-section" id="xj-phone" aria-labelledby="xj-phone-title">
      <div class="snow-section-heading" data-reveal>
        <p class="snow-kicker">03 / ON YOUR PHONE</p>
        <h2 id="xj-phone-title"><LocalizedText zh="手机上，也是完整的小吉终端。" en="The full terminal, on your phone." /></h2>
        <p><LocalizedText zh="打开手机浏览器就能用：以锁屏开场，通知可以直接进入对应内容；面对面、通讯器和基地地图都按手机屏幕重新排布。" en="Open it in a mobile browser: it starts on a lock screen whose notifications lead straight to the right place, and face-to-face scenes, the messenger, and the base map are laid out for a phone." /></p>
      </div>
      <ul class="xj-phones" data-reveal>
        {phoneShots.map((phone) => (
          <li>
            <figure>
              <XiaojiShot id={phone.shot} sizes={phoneSizes} />
              <figcaption><Icon name="smartphone" /> <LocalizedText {...phone.label} /></figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>

    <section class="snow-section" id="xj-updates" aria-labelledby="xj-updates-title">
      <div class="snow-section-heading snow-progress-heading" data-reveal>
        <div><p class="snow-kicker">04 / RECENT UPDATES</p><h2 id="xj-updates-title"><LocalizedText zh="这两周，小吉终端又多了这些。" en="What arrived in the last two weeks." /></h2></div>
        <time datetime={projectSnow.updatedAt}><LocalizedText zh="更新于" en="Updated" /> {projectSnow.updatedAt}</time>
      </div>
      <ol class="xj-updates">
        <li class="xj-update xj-update-promo" data-reveal>
          <time datetime={promo.publishedAt}>{promo.publishedAt}</time>
          <div>
            <h3><LocalizedText zh="1.0.0 宣传片在 B 站发布" en="The 1.0.0 launch film is on Bilibili" /></h3>
            <p><LocalizedText zh="四分半钟走完清晨到深夜的一天：面对面、文字通讯、九个地点、手机版、基地地图和记忆档案。" en="Four and a half minutes through one day, from dawn to late night: face-to-face scenes, messaging, nine places, the phone layout, the base map, and the memory archive." /></p>
            <a class="snow-text-link" href={promo.url} target="_blank" rel="noreferrer"><LocalizedText zh="去 B 站观看" en="Watch on Bilibili" /> <Icon name="arrow-up-right" /></a>
          </div>
        </li>
        {projectSnow.updates.map((update) => (
          <li class="xj-update" data-reveal>
            <time datetime={update.date}>{update.date}</time>
            <div><h3><LocalizedText {...update.title} /></h3><p><LocalizedText {...update.summary} /></p></div>
          </li>
        ))}
      </ol>
      <a class="snow-text-link snow-progress-link" href="/journal/#journal-project-project-snow"><LocalizedText zh="在开发日志里查看项目记录" en="Follow the project in the dev logs" /><span aria-hidden="true"><Icon name="arrow-right" /></span></a>
    </section>

    <StatisticsPanel scope="project_snow" title={{ zh: "小吉终端 · 延迟公开统计", en: "Xiaoji Terminal · delayed public statistics" }} />

    <section class="snow-section" id="xj-start" aria-labelledby="xj-start-title">
      <div class="snow-section-heading" data-reveal><p class="snow-kicker">05 / GET STARTED</p><h2 id="xj-start-title"><LocalizedText zh="三步，开始第一次对话。" en="Three steps to your first conversation." /></h2></div>
      <ol class="snow-start-steps">
        {startingSteps.map((step, index) => <li data-reveal><span class="snow-step-number" aria-hidden="true">0{index + 1}</span><div><h3><LocalizedText {...step.title} /></h3><p><LocalizedText {...step.description} /></p></div></li>)}
      </ol>
    </section>

    <section class="snow-section" id="snow-details" aria-labelledby="snow-details-title">
      <div class="snow-section-heading" data-reveal><p class="snow-kicker">06 / TECHNOLOGY & DATA</p><h2 id="snow-details-title"><LocalizedText zh="技术、数据与许可，完整说明。" en="Technology, data, and licensing." /></h2><p><LocalizedText zh="角色体验由什么构成、记录保存在哪里，以及资料与素材的使用方式。" en="What powers the character experience, where records are kept, and how sources and assets are used." /></p></div>
      <div class="snow-details">
        <article class="snow-detail-card" aria-labelledby="snow-technology-title" data-reveal>
          <header><span class="snow-detail-marker" aria-hidden="true">01</span><h3 id="snow-technology-title"><LocalizedText zh="技术栈与角色记忆" en="Technology and character memory" /></h3></header>
          <div class="snow-detail-body">
            <div class="snow-technology">
              <div><h4><LocalizedText zh="界面与本地状态" en="Interface and local state" /></h4><p><LocalizedText zh="原生 HTML、CSS 与 JavaScript ES Modules 构成终端界面，SSE 将模型回复逐步送回页面。IndexedDB 保存聊天记录、摘要、草稿、收藏与记忆档案，让通讯和面对面可以衔接同一段经历。" en="HTML, CSS, and JavaScript ES Modules power the terminal, with SSE streaming model replies. IndexedDB keeps chat history, summaries, drafts, favorites, and the memory archive so messaging and face-to-face scenes can continue the same story." /></p></div>
              <div><h4><LocalizedText zh="服务与模型连接" en="Services and model connections" /></h4><p><LocalizedText zh="Python 与 FastAPI 提供服务，配合 Pydantic、HTTPX 等组件处理请求与模型响应。公开体验支持 OpenAI、DeepSeek、阿里云百炼、智谱和 Moonshot，也可以通过本机个人连接器使用自己的 Codex 订阅。" en="Python and FastAPI provide services, with components such as Pydantic and HTTPX handling requests and model responses. The public experience supports OpenAI, DeepSeek, Alibaba Cloud Model Studio, Zhipu, and Moonshot, or your own Codex subscription through a personal connector on your computer." /></p></div>
              <div><h4><LocalizedText zh="资料检索与人物关系" en="Source retrieval and relationships" /></h4><p><LocalizedText zh="角色回应结合公开 Wiki 资料、人物关系与当前场景。SQLite FTS5 全文检索与本地向量召回共同寻找相关资料，Qdrant 承载向量检索，Neo4j 保存人物与剧情关系；检索结果为模型补充语境。" en="Replies draw on public Wiki material, relationships, and the current scene. SQLite FTS5 full-text search and local vector retrieval find relevant sources, with Qdrant serving vector search and Neo4j storing character and story relationships. Retrieved material adds context for the model." /></p></div>
            </div>
            <div class="snow-tech-list"><span>FastAPI</span><span>JavaScript</span><span>IndexedDB</span><span>SSE</span><span>SQLite FTS5</span><span>Qdrant</span><span>Neo4j</span></div>
            <a class="snow-text-link" href={site.repositories.projectSnow} target="_blank" rel="noreferrer"><LocalizedText zh="在 GitHub 查看源码" en="Explore the source on GitHub" /> <Icon name="arrow-up-right" /></a>
          </div>
        </article>
        <article class="snow-detail-card" aria-labelledby="snow-data-title" data-reveal>
          <header><span class="snow-detail-marker" aria-hidden="true">02</span><h3 id="snow-data-title"><LocalizedText zh="模型费用、记录与数据处理" en="Model costs, records, and data handling" /></h3></header>
          <div class="snow-detail-body">
            <dl class="snow-data-facts">
              <div><dt><LocalizedText zh="模型与费用" en="Models & costs" /></dt><dd><LocalizedText zh="无需注册，自备受支持模型服务的 API Key，或连接个人 Codex 订阅。对话内容会发送给所选服务商生成回复，费用由对应账号或订阅额度承担；每轮回复显示调用次数和 token，以厂商账单为准。" en="No registration is needed. Bring an API key for a supported provider or connect a personal Codex subscription. Conversation content is sent to that provider to generate replies and is billed to that account or plan; each reply shows its calls and tokens, and the provider's bill is authoritative." /></dd></div>
              <div><dt><LocalizedText zh="API Key" en="API key" /></dt><dd><LocalizedText zh="Key 经服务器内存转发，不写入数据库、磁盘、反馈或日志。加密凭证默认只保留在当前标签页，最长 12 小时；也可以在设置中选择在本机保存 2 小时到 7 天，公共设备请勿开启，点「清除模型会话」会立即作废。" en="The key is forwarded through server memory and is not written to the database, disk, feedback, or logs. By default the encrypted credential stays in the current tab for up to 12 hours; you can choose to keep it in this browser for 2 hours to 7 days (not on shared devices), and Clear model session revokes it immediately." /></dd></div>
              <div><dt><LocalizedText zh="主动消息" en="Messages from her" /></dt><dd><LocalizedText zh="「角色主动来消息」默认关闭。确认费用并开启后，当天约定到点时她会发来一条消息：每条调用一次模型，每个约定最多 1 条、每天最多 3 条，只在页面打开时生成，不会离线补发。" en="Messages from her are off by default. Once you confirm the cost and turn them on, she sends one message when a plan for that day is due: one model call each, at most one per plan and three a day, generated only while the page is open and never sent later." /></dd></div>
              <div><dt><LocalizedText zh="聊天记录与记忆" en="Chats & memory" /></dt><dd><LocalizedText zh="聊天、摘要、草稿、收藏与记忆档案以明文保存在当前浏览器，不会自动跨设备同步。可以在记录管理中回看或清理，共享设备上的记录也需要自行清理。" en="Chats, summaries, drafts, favorites, and the memory archive are stored as plaintext in the current browser and do not automatically sync across devices. Review or clear them through history management, including after using a shared device." /></dd></div>
              <div><dt><LocalizedText zh="反馈与联系" en="Feedback & contact" /></dt><dd><LocalizedText zh="提交前可以预览或取消附带的一问一答与请求编号。QQ 完全可选并加密保存，随反馈在 30 天后删除；反馈内容与完整清理规则见公开说明。" en="Preview or remove the attached question, answer, and request ID before submitting feedback. QQ is entirely optional, encrypted, and deleted with the feedback after 30 days. The public notice explains the full handling and deletion rules." /></dd></div>
            </dl>
            <a class="snow-text-link" href={site.external.projectSnowPrivacy} target="_blank" rel="noreferrer"><LocalizedText zh="阅读完整隐私与素材说明" en="Read the full privacy and asset notice" /> <Icon name="arrow-up-right" /></a>
          </div>
        </article>
        <article class="snow-detail-card" aria-labelledby="snow-license-title" data-reveal>
          <header><span class="snow-detail-marker" aria-hidden="true">03</span><h3 id="snow-license-title"><LocalizedText zh="资料来源与开源许可" en="Sources and open-source licensing" /></h3></header>
          <div class="snow-detail-body">
            <p><LocalizedText zh="小吉终端是基于《尘白禁区》公开 Wiki 资料的非官方、非商业项目，不代表游戏官方。知识资料、头像与表情按固定来源修订记录署名、许可依据与处理方式，具体页面的特殊声明优先。" en="Xiaoji Terminal is an unofficial, non-commercial project based on public Snowbreak Wiki material and is not affiliated with the game. Knowledge sources, avatars, and stickers record attribution, license basis, and transformations against fixed source revisions, with page-specific notices taking priority." /></p>
            <p><LocalizedText zh="公开署名索引用于说明资料从哪里来、经过哪些处理；它不代表项目已确认原始游戏美术的全部权属，也不构成额外授权。模型生成的对话可能偏离原作设定。" en="The public attribution index documents source material and its processing. It does not establish ownership of all original game artwork or grant additional rights. Model-generated dialogue may differ from canon." /></p>
            <dl class="snow-license-links">
              <div><dt><LocalizedText zh="资料来源" en="Source" /></dt><dd><a href={site.external.bWiki} target="_blank" rel="noreferrer">BWiki <Icon name="arrow-up-right" /></a></dd></div>
