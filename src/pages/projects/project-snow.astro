---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Giscus from "../../components/Giscus.astro";
import LocalizedText from "../../components/LocalizedText.astro";
import { site } from "../../config/site";

const projectShots = [
  {
    src: "/images/project-snow/chat-client.webp",
    alt: "Project Snow 聊天客户端，展示角色列表、对话时间线、模式切换和动作与对白双输入",
    type: { zh: "聊天客户端", en: "Chat client" },
    title: { zh: "把调试页拆成真正可以长期使用的聊天界面", en: "A chat interface designed for continued use, not just debugging" },
    description: {
      zh: "22 名角色集中在左侧会话列表；沉浸式 / 助手与面对面 / 文字通讯是两组独立开关。面对面模式可以把动作或神态与对白放在同一轮发送。",
      en: "All 22 characters live in one conversation list. Immersive / assistant and in-person / text are separate controls, while in-person turns can send an action or expression together with dialogue."
    }
  },
  {
    src: "/images/project-snow/evidence-workbench.webp",
    alt: "Project Snow 角色证据工作台，展示服务概览、证据检索、关系审核、实体审核和对话调试",
    type: { zh: "证据工作台", en: "Evidence workspace" },
    title: { zh: "对话之外，保留可以回头检查的证据与审核入口", en: "Evidence and review remain inspectable behind every dialogue" },
    description: {
      zh: "检索、关系审核、实体审核、用户反馈和对话调试被收进独立后台。模型生成的关系只会成为候选，未经审核不会写入正式图谱。",
      en: "Retrieval, relationship review, entity review, feedback, and dialogue debugging live in a separate workspace. Model-generated relationships remain candidates until reviewed."
    }
  },
  {
    src: "/images/project-snow/feedback-dialog.webp",
    alt: "Project Snow 问题反馈弹窗，提供角色表现、知识与记忆、对话体验、客户端功能和其他五类反馈",
    type: { zh: "反馈闭环", en: "Feedback loop" },
    title: { zh: "先说清是哪类问题，再留下具体上下文", en: "Classify the issue first, then preserve its context" },
    description: {
      zh: "反馈分为角色表现、知识与记忆、对话体验、客户端功能和其他五类，并自动关联角色、回答、模式与媒介；重复问题会归入同一问题族。",
      en: "Feedback is grouped into five categories and automatically carries the character, answer, mode, and medium. Repeated reports are linked to the same issue family."
    }
  },
  {
    src: "/images/project-snow/immersive-dialogue.webp",
    alt: "Project Snow 中肴的沉浸式面对面对话，动作神态与对白分块显示",
    type: { zh: "沉浸式体验", en: "Immersive dialogue" },
    title: { zh: "动作、对白、地点与关系前提一起构成当前场景", en: "Action, dialogue, location, and relationship premises form one scene" },
    description: {
      zh: "动作 / 神态与对白分块呈现，服务端同时检查交流媒介、地点和近期上下文。自然度与长对话连续性仍是当前持续打磨的重点。",
      en: "Actions and dialogue render as separate blocks while the server checks medium, location, and recent context. Naturalness and long-conversation continuity remain active areas of work."
    }
  }
];
---

<BaseLayout title="Project Snow" description="Project Snow 的 v0.5.0 人格与沉浸式基线已经完成，独立公网体验正在进行部署验证与私有验收准备。">
  <section class="section">
    <div class="container project-hero">
      <article class="project-summary" data-reveal>
        <div class="eyebrow">PROJECT / 01 · V0.5.0 BASELINE COMPLETE</div>
        <h1>Project Snow</h1>
        <p><LocalizedText zh="基于可追溯资料构建的《尘白禁区》角色对话项目。v0.5.0 已完成角色人格、沉浸式陪伴与助手双入口基线；新的面对面到场流程加入了概率先开口事件和移动动画，整体体验进一步向 Gal 靠拢。" en="A Snowbreak character-dialogue project built on traceable source material. v0.5.0 completes the character-persona baseline plus separate immersive-companion and assistant entry points. Face-to-face arrivals now include probabilistic character-first greetings and transition animation, moving the experience closer to a visual novel." /></p>
        <div class="button-row" style="margin-top: 24px">
          <a class="button" href={site.repositories.projectSnow} target="_blank" rel="noreferrer"><LocalizedText zh="查看 GitHub 源码 ↗" en="View GitHub source ↗" /></a>
          <a class="button button-secondary" href="/journal/?project=project-snow"><LocalizedText zh="阅读 Project Snow 日志" en="Read Project Snow logs" /></a>
        </div>
      </article>
      <aside class="status-panel" data-reveal>
        <div>
          <span class="status-badge"><LocalizedText zh="v0.5 基线完成 · 私有验收准备中" en="v0.5 baseline complete · private acceptance preparation" /></span>
          <strong><LocalizedText zh="16 核 16GB 服务器正在准备全量部署" en="A 16-core, 16 GB server is being prepared for full deployment" /></strong>
          <p><LocalizedText zh="公网进程只暴露独立的沉浸式 API 与静态客户端，不挂载内部工作台、附件、语音或 Agent 接口；当前仍在全量测试、迁移校验与生产 Compose 检查阶段，尚未开放试玩。" en="The public process exposes only an isolated immersive API and static client; internal workspace, attachment, voice, and Agent endpoints are not mounted. Full tests, migration validation, and production Compose checks are still in progress, and the preview is not open." /></p>
        </div>
        <div class="tag-list"><span class="tag">FastAPI</span><span class="tag">PostgreSQL</span><span class="tag">Qdrant</span><span class="tag">Neo4j</span><span class="tag">Docker</span></div>
      </aside>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="snapshot-title">
    <div class="container">
      <div class="section-header" data-reveal>
        <div>
          <div class="section-kicker"><LocalizedText zh="最新快照" en="Latest snapshot" /></div>
          <h2 id="snapshot-title"><LocalizedText zh="v0.5 基线已经合入主线，下一步是安全地完成公网私有验收。" en="The v0.5 baseline has landed on main; the next step is a secure private acceptance of the public deployment." /></h2>
        </div>
        <p><LocalizedText zh="以下数据来自 2026 年 8 月 14 日的 v0.5 主线基线与公网部署分支。主线能力已经验证；公网部署仍处于独立分支的验证阶段，不代表服务已经开放。" en="These figures reflect the v0.5 mainline baseline and public-deployment branch as of August 14, 2026. Mainline capabilities are validated; the public deployment remains under validation on an isolated branch and is not open." /></p>
      </div>
      <div class="project-metrics" data-reveal>
        <article><strong>22</strong><span><LocalizedText zh="名可对话角色" en="dialogue characters" /></span></article>
        <article><strong>234 + 1</strong><span><LocalizedText zh="项主线测试通过 / 跳过" en="mainline tests passed / skipped" /></span></article>
        <article><strong>5,919</strong><span><LocalizedText zh="个可发布图谱节点" en="publishable graph nodes" /></span></article>
        <article class="project-metric-wide"><strong>7,698</strong><span><LocalizedText zh="条可追溯图谱关系进入发布视图" en="traceable graph edges in the publishable view" /></span></article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="pipeline-title">
    <div class="container">
      <div class="section-header" data-reveal>
        <div>
          <div class="section-kicker"><LocalizedText zh="从证据到对话" en="From evidence to dialogue" /></div>
          <h2 id="pipeline-title"><LocalizedText zh="不是只给模型一份角色设定，而是给每一步留下边界。" en="Not just a character prompt—each stage has an explicit boundary." /></h2>
        </div>
        <p><LocalizedText zh="原始语料保持只读，公网只读取带哈希和许可元数据的发布产物。API Key 不写入数据库，聊天历史默认由浏览器携带，反馈则进入独立的限期存储与清理流程。" en="Raw source material remains read-only, and the public service reads only release artifacts with hashes and license metadata. API keys are not written to the database, chat history is carried by the browser by default, and feedback follows a separate retention and cleanup path." /></p>
      </div>
      <div class="pipeline project-pipeline">
        <article class="pipeline-step" data-reveal><span class="step-number">01 / SOURCE</span><h3><LocalizedText zh="采集与溯源" en="Collection & provenance" /></h3><p><LocalizedText zh="保留页面地址、正文、哈希、分类和运行状态，支持增量发现与失败恢复。" en="Preserve URLs, text, hashes, categories, and run state for incremental discovery and recovery." /></p></article>
        <article class="pipeline-step" data-reveal><span class="step-number">02 / RETRIEVAL</span><h3><LocalizedText zh="混合检索" en="Hybrid retrieval" /></h3><p><LocalizedText zh="SQLite FTS5 与本地中文向量经 RRF 融合，再按角色和资料层级重排证据。" en="SQLite FTS5 and local Chinese vectors are fused with RRF, then reranked by character and evidence tier." /></p></article>
        <article class="pipeline-step" data-reveal><span class="step-number">03 / V0.3 AGENT</span><h3><LocalizedText zh="多模态 Agent 基线" en="Multimodal Agent baseline" /></h3><p><LocalizedText zh="多 Provider、图片 / 文档 / 音频、STT / TTS、25 个工具、持久化状态机、审批与 Artifact 已在 v0.3.0 完成。" en="v0.3.0 completed multiple providers, images, documents, audio, STT/TTS, 25 tools, a persistent state machine, approvals, and Artifacts." /></p></article>
        <article class="pipeline-step" data-reveal><span class="step-number">04 / V0.5 UI</span><h3><LocalizedText zh="Gal 化沉浸式体验" en="Visual-novel-style immersion" /></h3><p><LocalizedText zh="双入口、共享人物状态与固定侧栏已经形成基线；面对面到场加入概率先开口事件和移动动画，场景背景仍待后续补齐。" en="Dual entry points, shared character state, and the fixed sidebar now form the baseline. Face-to-face arrivals add probabilistic character-first greetings and transition animation, while scene backgrounds remain future work." /></p></article>
        <article class="pipeline-step" data-reveal><span class="step-number">05 / PRIVATE ACCEPTANCE</span><h3><LocalizedText zh="隔离公网面与安全验收" en="Isolated public surface and security acceptance" /></h3><p><LocalizedText zh="FastAPI、PostgreSQL、Qdrant、Neo4j、Caddy 与 Cloudflare Tunnel 采用独立生产编排；试玩按钮会等私有验收和二次确认后再接入本站。" en="FastAPI, PostgreSQL, Qdrant, Neo4j, Caddy, and Cloudflare Tunnel use an isolated production stack. The play button will reach this site only after private acceptance and a second explicit approval." /></p></article>
      </div>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="showcase-title">
    <div class="container">
      <div class="section-header" data-reveal>
        <div>
          <div class="section-kicker"><LocalizedText zh="旧界面记录" en="Previous interface record" /></div>
          <h2 id="showcase-title"><LocalizedText zh="这些画面记录了 v0.2.3；新的 Gal 风沉浸式 UI 正在进入部署验收。" en="These screens document v0.2.3; the new visual-novel-style immersive UI is entering deployment acceptance." /></h2>
        </div>
        <p><LocalizedText zh="当前截图仍是旧阶段记录，不代表已经完成的 v0.5 基线外观；待私有部署稳定后再统一替换。点击任意图片可以完整查看上一阶段界面。" en="These screenshots remain a record of the previous stage and do not represent the completed v0.5 baseline. They will be replaced after the private deployment stabilizes. Select any image to inspect the earlier interface." /></p>
      </div>
      <div class="project-showcase">
        {projectShots.map((shot, index) => (
          <article class={`project-shot project-shot-${index + 1}`} data-reveal>
            <button
              class="project-shot-open"
              type="button"
              data-project-shot-open
              data-project-shot-src={shot.src}
              data-project-shot-alt={shot.alt}
              data-project-shot-caption={shot.description.zh}
              aria-label={`查看大图：${shot.title.zh}`}
              aria-haspopup="dialog"
            >
              <img src={shot.src} alt={shot.alt} width="1600" height={index === 1 ? 934 : index === 2 ? 941 : index === 3 ? 939 : 938} loading="lazy" decoding="async" />
              <span class="project-shot-zoom" aria-hidden="true">↗</span>
            </button>
            <div class="project-shot-copy">
              <span class="project-shot-type"><LocalizedText {...shot.type} /></span>
              <h3><LocalizedText {...shot.title} /></h3>
              <p><LocalizedText {...shot.description} /></p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="roadmap-title">
    <div class="container split-panel">
      <div data-reveal>
        <div class="section-kicker"><LocalizedText zh="当前边界与下一步" en="Current boundaries & next steps" /></div>
        <h2 id="roadmap-title"><LocalizedText zh="从本地可运行，推进到边界清晰、可回滚的公网体验。" en="From a working local product to a bounded, rollback-ready public experience." /></h2>
        <div class="timeline" style="margin-top: 24px">
          <article class="timeline-card"><span class="timeline-phase"><LocalizedText zh="已完成" en="Complete" /></span><div><h3><LocalizedText zh="v0.5.0 人格与沉浸式基线" en="v0.5.0 persona and immersive baseline" /></h3><p><LocalizedText zh="22 名角色、双入口、共享人物状态、面对面到场流程、固定侧栏工作台与可发布图谱已经合入主线；234 项测试通过、1 项因权限跳过。" en="Twenty-two characters, dual entry points, shared character state, face-to-face arrivals, the fixed-sidebar workspace, and a publishable graph have landed on main; 234 tests pass and one is skipped for permissions." /></p></div></article>
          <article class="timeline-card"><span class="timeline-phase"><LocalizedText zh="进行中" en="In progress" /></span><div><h3><LocalizedText zh="16 核服务器全量部署与私有验收" en="Full deployment and private acceptance on a 16-core server" /></h3><p><LocalizedText zh="公网分支正在验证数据库迁移、生产 Compose、镜像固定、备份恢复、限流、BYOK、反馈加密与 30 天清理；Cloudflare Access 会在验收期间保持开启。" en="The public branch is validating database migrations, production Compose, pinned images, backup and restore, rate limits, BYOK, encrypted feedback, and 30-day cleanup. Cloudflare Access remains enabled throughout acceptance." /></p></div></article>
          <article class="timeline-card"><span class="timeline-phase"><LocalizedText zh="验收后" en="After acceptance" /></span><div><h3><LocalizedText zh="受控网站试玩" en="Controlled web preview" /></h3><p><LocalizedText zh="部署完成后先内部测试数日；只有 Provider 真钥匙 smoke、安全边界与回滚流程都通过，并再次确认后，才会把试玩入口接入本站。" en="After deployment, the service will undergo several days of internal testing. The play entry reaches this site only after real-provider smoke tests, security boundaries, and rollback paths pass and a second approval is given." /></p></div></article>
          <article class="timeline-card"><span class="timeline-phase"><LocalizedText zh="后续探索" en="Later" /></span><div><h3><LocalizedText zh="场景背景、角色语音与跨设备助手" en="Scene backgrounds, character voice, and cross-device assistance" /></h3><p><LocalizedText zh="继续补齐 Gal 化场景背景、角色语音、助手工具与手机 / 电脑联动；所有高权限工具仍需明确审批和审计。" en="Continue with visual-novel-style scene backgrounds, character voice, assistant tools, and phone/desktop integration while keeping high-privilege tools behind explicit approval and audit." /></p></div></article>
        </div>
      </div>
      <aside class="license-note license-note-compact" data-reveal>
        <header class="license-note-header">
          <span class="license-note-mark" aria-hidden="true">※</span>
          <div>
            <span class="license-note-kicker">DATA BOUNDARY / 01</span>
            <strong><LocalizedText zh="来源、许可与隐私" en="Sources, licensing & privacy" /></strong>
          </div>
        </header>
        <p class="license-note-lead"><LocalizedText zh="项目资料来自尘白禁区 BWiki；页面特殊声明优先，游戏与角色内容版权归其权利人。" en="Project material comes from the Snowbreak BWiki; page-specific notices take priority, and game and character rights remain with their owners." /></p>
        <ul class="license-note-list">
          <li><span><LocalizedText zh="来源" en="Source" /></span><a href={site.external.bWiki} target="_blank" rel="noreferrer">BWiki ↗</a></li>
          <li><span><LocalizedText zh="许可" en="License" /></span><a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noreferrer">CC BY-NC-SA 4.0 ↗</a></li>
          <li><span><LocalizedText zh="隐私" en="Privacy" /></span><em><LocalizedText zh="API Key 不入库；历史默认在浏览器；反馈限期保留" en="API keys stay out of the database; history stays in the browser; feedback is retained temporarily" /></em></li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section-tight">
    <div class="container notice-panel" data-reveal>
      <div class="section-kicker"><LocalizedText zh="私有验收 / 在线服务" en="Private acceptance / public service" /></div>
      <h2><LocalizedText zh="v0.5.0 基线已经完成；公网服务正在部署验证，尚未开放试玩。" en="The v0.5.0 baseline is complete; the public service is under deployment validation and is not open yet." /></h2>
      <p><LocalizedText zh="公网服务与内部工作台完全分离，默认由用户自带模型凭据；API Key 只进入短期、绑定匿名会话的加密凭据，不写入数据库。聊天历史默认保留在浏览器，反馈数据采用独立加密、去重、限流与 30 天清理。私有验收期间继续由 Cloudflare Access 隔离。" en="The public service is fully separated from the internal workspace and uses user-provided model credentials by default. API keys enter only short-lived encrypted credentials bound to an anonymous session and are not written to the database. Chat history remains in the browser by default, while feedback uses separate encryption, deduplication, rate limiting, and 30-day cleanup. Cloudflare Access remains the private acceptance gate." /></p>
      <div class="button-row" style="margin-top: 18px"><a class="button button-secondary" href={site.repositories.projectSnow} target="_blank" rel="noreferrer"><LocalizedText zh="查看项目运行说明 ↗" en="View setup instructions ↗" /></a></div>
    </div>
  </section>

  <dialog class="project-shot-lightbox" data-project-shot-lightbox aria-labelledby="project-shot-lightbox-title">
    <div class="project-shot-lightbox-frame">
      <div class="project-shot-lightbox-bar">
        <span id="project-shot-lightbox-title"><LocalizedText zh="Project Snow 界面预览" en="Project Snow interface preview" /></span>
        <button type="button" data-project-shot-close aria-label="关闭大图预览">×</button>
      </div>
      <figure>
        <img data-project-shot-image alt="" width="1600" height="938" />
        <figcaption data-project-shot-caption></figcaption>
      </figure>
    </div>
  </dialog>

  <Giscus />
</BaseLayout>

<script>
  const lightbox = document.querySelector<HTMLDialogElement>("[data-project-shot-lightbox]");
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>("[data-project-shot-image]");
  const lightboxCaption = lightbox?.querySelector<HTMLElement>("[data-project-shot-caption]");
  const shotTriggers = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-project-shot-open]"));
  let activeTrigger: HTMLButtonElement | undefined;

  const closeLightbox = () => {
    if (lightbox?.open) lightbox.close();
  };

  if (lightbox && lightboxImage && lightboxCaption && typeof lightbox.showModal === "function") {
    shotTriggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const src = trigger.dataset.projectShotSrc;
        if (!src) return;
        activeTrigger = trigger;
        lightboxImage.src = src;
        lightboxImage.alt = trigger.dataset.projectShotAlt || "";
        const localizedCaption = trigger.closest(".project-shot")?.querySelector<HTMLElement>(".project-shot-copy p");
        lightboxCaption.textContent = localizedCaption?.textContent?.trim() || trigger.dataset.projectShotCaption || "";
        if (!lightbox.open) lightbox.showModal();
      });
    });

    lightbox.querySelector<HTMLButtonElement>("[data-project-shot-close]")?.addEventListener("click", closeLightbox);
    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) closeLightbox();
    });
    lightbox.addEventListener("close", () => {
      lightboxImage.removeAttribute("src");
      lightboxImage.alt = "";
      lightboxCaption.textContent = "";
      activeTrigger?.focus();
    });
  }
</script>
