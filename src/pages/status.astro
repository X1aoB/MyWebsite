---
import BaseLayout from "../layouts/BaseLayout.astro";
import LocalizedText from "../components/LocalizedText.astro";
import { site } from "../config/site";
import { projectSnow } from "../config/project-snow";
---

<BaseLayout title="站点状态" description="小B个人网站的静态部署与运行说明。">
  <section class="section status-page">
    <div class="container">
      <header class="page-hero" data-reveal>
        <div class="eyebrow">Site status</div>
        <h1><LocalizedText zh="站点状态" en="Site status" /></h1>
        <p>
          <LocalizedText
            zh="这里记录个人站和小吉终端目前如何运行。个人站保持静态优先，游戏试玩作为独立动态服务部署。"
            en="This page records how the personal site and Xiaoji Terminal currently run. The personal site stays static-first, while the game preview is deployed as a separate dynamic service."
          />
        </p>
      </header>

      <div class="status-grid">
        <article class="notice-panel status-summary" data-reveal>
          <p class="section-kicker"><LocalizedText zh="当前部署" en="Current deployment" /></p>
          <div class="status-summary-line">
            <span class="status-dot" aria-hidden="true"></span>
            <strong><LocalizedText zh="静态站点运行中" en="Static site is live" /></strong>
          </div>
          <p>
            <LocalizedText
              zh="本站由 Astro 构建并部署在 Cloudflare Pages。每次推送 main 分支后，Pages 会重新构建并发布静态文件。"
              en="The site is built with Astro and deployed on Cloudflare Pages. A push to the main branch triggers a new static build and deployment."
            />
          </p>
          <a class="text-link" href={site.repositories.website} target="_blank" rel="noreferrer">
            <LocalizedText zh="查看公开代码" en="View public code" /> <span aria-hidden="true">↗</span>
          </a>
        </article>

        <article class="notice-panel" data-reveal>
          <p class="section-kicker"><LocalizedText zh="服务边界" en="Service boundaries" /></p>
          <h2><LocalizedText zh={`小吉终端 ${projectSnow.publicVersion} 公开体验`} en={`Xiaoji Terminal ${projectSnow.publicVersion} public experience`} /></h2>
          <p>
            <LocalizedText
              zh="试玩入口运行在 snow.xiaob.dev，与本站 Cloudflare Pages 部署彼此独立。这里暂未接入统一的实时 uptime 监控，因此页脚状态不代表模型供应商或小吉终端每个后端依赖的实时可用性。"
              en="The preview runs at snow.xiaob.dev independently from this Cloudflare Pages deployment. Unified live uptime monitoring is not connected yet, so the footer status does not represent real-time availability for model providers or every Xiaoji Terminal backend dependency."
            />
          </p>
          <a class="text-link" href={site.external.projectSnowPlay} target="_blank" rel="noreferrer"><LocalizedText zh="打开小规模测试 ↗" en="Open the small-scale test ↗" /></a>
        </article>

        <article class="notice-panel" data-reveal>
          <p class="section-kicker"><LocalizedText zh="站点信息" en="Site details" /></p>
          <dl class="status-details">
            <div>
              <dt><LocalizedText zh="部署平台" en="Platform" /></dt>
              <dd>Cloudflare Pages</dd>
            </div>
            <div>
              <dt><LocalizedText zh="内容模式" en="Content mode" /></dt>
              <dd><LocalizedText zh="静态文件 + Git 管理" en="Static files + Git" /></dd>
            </div>
            <div>
              <dt><LocalizedText zh="独立服务" en="Separate service" /></dt>
              <dd>小吉终端 {projectSnow.publicVersion}</dd>
            </div>
          </dl>
        </article>

        <article class="notice-panel" data-reveal>
          <p class="section-kicker"><LocalizedText zh="透明说明" en="Transparency" /></p>
          <p>
            <LocalizedText {...site.legal.status} />
          </p>
          <p class="status-note">
            <LocalizedText
              zh="后续接入统一监控时，会在这里明确区分个人站、小吉终端、模型供应商与数据依赖，并标注数据来源和最近一次检查时间。"
              en="When unified monitoring is added, this page will distinguish the personal site, Xiaoji Terminal, model providers, and data dependencies, with source and latest-check details."
            />
          </p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
