---
import Icon from "../../components/Icon.astro";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import JournalEntry from "../../components/JournalEntry.astro";
import LocalizedText from "../../components/LocalizedText.astro";
import { compareReadingPosts } from "../../lib/reading";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(compareReadingPosts);

const projectGroups = [...new Set(posts.map((post) => post.data.project))].map((project) => ({
  project,
  posts: posts.filter((post) => post.data.project === project)
}));

const projectAnchor = (project: string) =>
  project === "小吉终端" ? "journal-project-project-snow" :
    `journal-project-${project.toLowerCase().replace(/[^a-z0-9\u4e00-\u9fff]+/gi, "-").replace(/^-|-$/g, "")}`;
---

<BaseLayout title="开发日志" description="记录 小吉终端 与数据工程实践中的设计、约束和构建过程。">
  <section class="page-hero">
    <div class="container" data-reveal>
      <div class="eyebrow">Build notes / 中文优先</div>
      <h1>开发日志</h1>
      <p>小B的项目开发路程</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container journal-project-list">
      {
        projectGroups.map((group) => (
          <section class="journal-project-group" id={projectAnchor(group.project)} data-reveal>
            <header class="journal-project-heading">
              <div>
                <div class="section-kicker">Project log</div>
                <h2>{group.project}</h2>
                <p><LocalizedText zh={`${group.posts.length} 篇开发记录`} en={`${group.posts.length} dev log${group.posts.length === 1 ? "" : "s"}`} /></p>
              </div>
              {group.project === "小吉终端" && (
                <a class="text-link" href="/projects/project-snow/">
                  <LocalizedText zh="查看项目" en="View project" /><span aria-hidden="true"><Icon name="arrow-up-right" /></span>
                </a>
              )}
            </header>
            <ol class="journal-timeline">
              {group.posts.map((post) => <li><JournalEntry post={post} /></li>)}
            </ol>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>

