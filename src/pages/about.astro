---
import LocalizedText from "../components/LocalizedText.astro";
import { profile } from "../config/profile";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="关于" description="小B的个人介绍、项目链接与联系入口。">
  <section class="section">
    <div class="container about-grid">
      <article class="about-card about-intro-card" data-reveal>
        <div class="eyebrow">About / Xiao B</div>
        <h1><LocalizedText {...profile.about.title} /></h1>
        <p class="about-template-hint"><LocalizedText {...profile.about.summary} /></p>

        <div class="about-bio-template">
          {profile.about.details.map((detail) => (
            <div>
              <span><LocalizedText {...detail.label} /></span>
              <p><LocalizedText {...detail.value} /></p>
            </div>
          ))}
        </div>
      </article>

      <aside class="about-card about-links-card" data-reveal>
        <div class="section-kicker"><LocalizedText zh="我的链接" en="My links" /></div>
        <ul class="about-link-list" aria-label="小B的链接">
          {profile.links.map((link) => (
            <li>
              <a href={link.href} target={link.href.startsWith("mailto:") ? undefined : "_blank"} rel={link.href.startsWith("mailto:") ? undefined : "noreferrer"}>
                <span><b><LocalizedText {...link.label} /></b><small><LocalizedText {...link.description} /></small></span><i aria-hidden="true">{link.href.startsWith("mailto:") ? "@" : "↗"}</i>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section-tight">
    <div class="container about-template-notes">
      <article class="notice-panel" data-reveal>
        <div class="section-kicker">正在做什么</div>
        <h2><LocalizedText {...profile.about.current.title} /></h2>
        <p><LocalizedText {...profile.about.current.description} /></p>
      </article>
      <article class="notice-panel" data-reveal>
        <div class="section-kicker">合作与联系</div>
        <h2><LocalizedText {...profile.about.contact.title} /></h2>
        <p><LocalizedText {...profile.about.contact.description} /></p>
      </article>
    </div>
  </section>
</BaseLayout>
