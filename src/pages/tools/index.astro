---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LocalizedText from "../../components/LocalizedText.astro";
import { tools } from "../../config/tools";

const categories = [
  { id: "ai", label: "AI tools", title: { zh: "AI 工具", en: "AI tools" }, description: { zh: "整理模型观察与公开基准，给比较一个清楚的起点。", en: "Model observations and public benchmarks, with a clear starting point for comparisons." } },
  { id: "data", label: "Data tools", title: { zh: "数据工具", en: "Data tools" }, description: { zh: "在浏览器里处理手边的数据，轻量、直接，也不必上传。", en: "Work with the data at hand, directly in your browser. No upload needed." } }
];
---

<BaseLayout title="工具" description="用于模型观察与本地数据处理的小工具：模型 IQ 雷达和 JSON 工作台。">
  <section class="page-hero">
    <div class="container" data-reveal>
      <div class="eyebrow">Small tools / useful things</div>
      <h1><LocalizedText zh="工具" en="Tools" /></h1>
      <p><LocalizedText zh="把平时用得上的小功能，收进一个顺手的角落。" en="A small collection of useful things, ready when you need them." /></p>
    </div>
  </section>
  <section class="section-tight">
    <div class="container tool-directory">
      {categories.map((category) => (
        <section class="tool-category" aria-labelledby={`${category.id}-tools-title`} data-reveal>
          <header class="tool-category-heading">
            <div><div class="section-kicker">{category.label}</div><h2 id={`${category.id}-tools-title`}><LocalizedText {...category.title} /></h2></div>
            <p><LocalizedText {...category.description} /></p>
          </header>
          <div class="tool-entry-grid">
            {tools.filter((tool) => tool.category === category.id).map((tool) => (
              <a class="tool-entry" href={tool.url}>
                <span class="tool-entry-icon" aria-hidden="true">{tool.icon}</span>
                <span class="tool-entry-copy">
                  <span class="tool-entry-status"><i aria-hidden="true"></i><LocalizedText {...tool.status} /></span>
                  <strong><LocalizedText {...tool.title} /></strong>
                  <span><LocalizedText {...tool.description} /></span>
                </span>
                <span class="tool-entry-arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
