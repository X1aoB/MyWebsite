---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LocalizedText from "../../components/LocalizedText.astro";
import JsonWorkbench from "../../components/JsonWorkbench.astro";
---

<BaseLayout title="JSON 工作台" description="在浏览器中格式化、压缩和校验 JSON；保留大整数精度，支持复制与下载，数据仅在本地处理。">
  <section class="page-hero">
    <div class="container" data-reveal>
      <a class="text-link" href="/tools/"><span aria-hidden="true">←</span><LocalizedText zh="返回工具" en="Back to tools" /></a>
      <p class="eyebrow">Data tools / local workbench</p>
      <h1><LocalizedText zh="JSON 工作台" en="JSON workbench" /></h1>
      <p><LocalizedText zh="把挤成一团的数据展开，或把整理好的结构收紧。一个不需要上传文件的小工作台。" en="Unfold a dense block of data, or compact a readable structure. A small workbench that keeps your data in your browser." /></p>
    </div>
  </section>
  <section class="section-tight">
    <div class="container"><JsonWorkbench /></div>
  </section>
</BaseLayout>
